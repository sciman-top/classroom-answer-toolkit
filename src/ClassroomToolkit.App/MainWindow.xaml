<Window x:Class="ClassroomToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classroom Answer Toolkit"
        Width="1360"
        Height="860"
        MinWidth="960"
        MinHeight="640"
        Background="#F4F6F8"
        Foreground="#17202A"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="原卷到答案交付" FontSize="28" FontWeight="SemiBold" />

                <TextBlock Margin="0,6,0,12" Text="先选择原卷，生成候选、执行复核并输出 PDF；已有答案也可直接重新排版。" Foreground="#5D6D7E" TextWrapping="Wrap" />
                <TextBlock Text="原卷 PDF" FontWeight="SemiBold" />
                <TextBox Margin="0,6,0,8" Text="{Binding SelectedSourcePdfPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                <Button Content="选择原卷" Command="{Binding BrowseSourcePdfCommand}" HorizontalAlignment="Left" />

                <TextBlock Margin="0,14,0,0" Text="权威参考答案 PDF（可选）" FontWeight="SemiBold" />
                <TextBox Margin="0,6,0,8" Text="{Binding SelectedReferencePdfPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                <Button Content="选择参考答案" Command="{Binding BrowseReferencePdfCommand}" HorizontalAlignment="Left" />

                <TextBlock Margin="0,14,0,0" Text="工作流输出目录" FontWeight="SemiBold" />
                <TextBox Margin="0,6,0,0" Text="{Binding SelectedWorkflowOutputDirectory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />

                <CheckBox Margin="0,12,0,0" IsChecked="{Binding AllowCloudEgress}" Content="允许本次工作流向已配置的 AI 服务发送原卷图片与答案材料" />
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding SkipVisualAudit}" Content="跳过视觉审计（仅诊断用，不能作为可信交付）" />
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding UseGatewayProxy}" Content="使用本机 HTTP 代理配置连接 AI 网关" />
                <Button Margin="0,12,0,0" Content="生成并交付参考答案" Command="{Binding RunLiveWorkflowCommand}" Background="#B42318" HorizontalAlignment="Stretch" />

                <Separator Margin="0,20,0,18" />
                <TextBlock Text="已有答案重新排版" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Text="答案 Markdown" FontWeight="SemiBold" />
                <TextBox Margin="0,6,0,8" Text="{Binding SelectedAnswerMarkdownPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                <Button Content="选择 Markdown" Command="{Binding BrowseAnswerMarkdownCommand}" HorizontalAlignment="Left" />

                <TextBlock Margin="0,18,0,0" Text="输出 PDF" FontWeight="SemiBold" />
                <TextBox Margin="0,6,0,0" Text="{Binding SelectedOutputPdfPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Subject Pack" FontWeight="SemiBold" />
                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding AvailableSubjectPacks}" SelectedItem="{Binding SelectedSubjectPack}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="排版模式" FontWeight="SemiBold" />
                        <ComboBox Margin="0,6,0,0" SelectedValue="{Binding SelectedProfile}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="课堂版" Tag="classroom" />
                            <ComboBoxItem Content="紧凑版" Tag="compact" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <CheckBox Margin="0,16,0,0" IsChecked="{Binding KeepReviewArtifacts}" Content="保留 PDF 页图供人工复核" />
                <Button Margin="0,20,0,0" Content="生成排版答案 PDF" Command="{Binding DeliverCommand}" Background="#B42318" HorizontalAlignment="Stretch" />

                <Separator Margin="0,24,0,18" />
                <TextBlock Text="最近交付" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Margin="0,10,0,0" Text="{Binding LastOutputPdfPath, StringFormat=PDF: {0}}" TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0" Text="{Binding LastDeliveryManifestPath, StringFormat=Manifest: {0}}" TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0" Text="{Binding LastSnapshotId, StringFormat=Snapshot: {0}}" TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0" Text="{Binding LastWorkflowReceiptPath, StringFormat=Workflow: {0}}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="打开答案 MD" Command="{Binding OpenLastAnswerMarkdownCommand}" />
                    <Button Content="打开 PDF" Command="{Binding OpenLastOutputPdfCommand}" />
                    <Button Content="打开 Manifest" Command="{Binding OpenLastDeliveryManifestCommand}" />
                    <Button Content="打开回执" Command="{Binding OpenLastWorkflowReceiptCommand}" />
                    <Button Content="打开页图" Command="{Binding OpenLastReviewDirectoryCommand}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="主链状态" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Text="{Binding StatusMessage}" Foreground="#34495E" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Text="{Binding LastResultSummary}" Foreground="#6C7A89" />
                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Text="更新：" Foreground="#5D6D7E" />
                    <TextBlock Text="{Binding UpdateStatus}" Foreground="#5D6D7E" TextWrapping="Wrap" />
                    <Button Margin="10,0,0,0" Content="检查更新" Command="{Binding CheckForUpdatesCommand}" />
                    <Button Content="安装更新" Command="{Binding InstallUpdateCommand}" />
                </WrapPanel>
            </StackPanel>

            <ItemsControl Grid.Row="1" Margin="0,18,0,18" ItemsSource="{Binding StatusCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="205" Margin="0,0,10,10" Padding="10" Background="White" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="#5D6D7E" FontSize="12" />
                                <TextBlock Margin="0,5,0,0" Text="{Binding Value}" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding Detail}" Foreground="#7B7D7D" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Grid.Row="2" Text="{Binding ActivityLog}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="#111827" Foreground="#E5E7EB"
                     BorderThickness="0" FontFamily="Cascadia Mono" />

            <WrapPanel Grid.Row="3" Margin="0,16,0,0">
                <Button Content="执行主链体检" Command="{Binding CheckCommand}" Background="#176B87" />
                <Button Content="安装 / 修复依赖" Command="{Binding BootstrapCommand}" Background="#566573" />
                <Button Content="取消当前任务" Command="{Binding CancelCommand}" Background="#B42318" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
