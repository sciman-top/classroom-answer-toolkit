{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/optimization-readiness-report/v2.json",
  "compatibility": {
    "forward": "breaking_v2_requires_qualified_metrics",
    "backward": "breaking_v2_requires_qualified_metrics"
  },
  "title": "OptimizationReadinessReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "evaluationId",
    "sourceManifestSha256",
    "thresholds",
    "controls",
    "caseBindings",
    "buckets",
    "unresolvedLeakageCount",
    "eligible",
    "reasonCodes",
    "optimizationCandidateRefs"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["2.0"] },
    "kind": {
      "type": "string",
      "enum": ["optimization-readiness-report"]
    },
    "evaluationId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "thresholds": {
      "type": "object",
      "required": [
        "perturbedNegativeRecall",
        "nonPerturbedMinimumSampleCount",
        "nonPerturbedRecall"
      ],
      "properties": {
        "perturbedNegativeRecall": { "type": "number", "minimum": 0, "maximum": 1 },
        "nonPerturbedMinimumSampleCount": { "type": "integer", "minimum": 1 },
        "nonPerturbedRecall": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": ["toolchainStatus", "restrictedEgressStatus"],
      "properties": {
        "toolchainStatus": {
          "type": "string",
          "enum": ["not_verified", "passed", "failed"]
        },
        "restrictedEgressStatus": {
          "type": "string",
          "enum": ["not_verified", "no_violation_observed", "violation"]
        },
        "receiptStatus": {
          "type": "string",
          "enum": ["unattested_local_record"]
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "additionalProperties": false
    },
    "caseBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "sampleId",
          "candidateSourceType",
          "candidateDescriptorSha256",
          "releaseQualification",
          "expectedError",
          "detected"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sampleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "candidateSourceType": {
            "type": "string",
            "enum": ["perturbed_negative", "historical_candidate", "generated"]
          },
          "runSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "feedbackSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "candidateDescriptorSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "releaseQualification": {
            "$ref": "release-qualification.schema.json"
          },
          "expectedError": { "type": "boolean" },
          "detected": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidateSourceType",
          "n",
          "expectedErrorCount",
          "detectedErrorCount",
          "recallStatus",
          "qualifiedN",
          "qualifiedExpectedErrorCount",
          "qualifiedDetectedErrorCount",
          "qualifiedRecallStatus"
        ],
        "properties": {
          "candidateSourceType": {
            "type": "string",
            "enum": ["perturbed_negative", "historical_candidate", "generated"]
          },
          "n": { "type": "integer", "minimum": 0 },
          "expectedErrorCount": { "type": "integer", "minimum": 0 },
          "detectedErrorCount": { "type": "integer", "minimum": 0 },
          "recallStatus": {
            "type": "string",
            "enum": ["available", "unavailable"]
          },
          "recall": { "type": "number", "minimum": 0, "maximum": 1 },
          "qualifiedN": { "type": "integer", "minimum": 0 },
          "qualifiedExpectedErrorCount": { "type": "integer", "minimum": 0 },
          "qualifiedDetectedErrorCount": { "type": "integer", "minimum": 0 },
          "qualifiedRecallStatus": {
            "type": "string",
            "enum": ["available", "unavailable"]
          },
          "qualifiedRecall": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "unresolvedLeakageCount": { "type": "integer", "minimum": 0 },
    "eligible": { "type": "boolean" },
    "reasonCodes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "optimizationCandidateRefs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
