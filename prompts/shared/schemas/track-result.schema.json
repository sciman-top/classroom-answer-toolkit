{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/track-result/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "TrackResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "trackResultId",
    "evidenceBundleRef",
    "trackType",
    "answerCandidate",
    "confidence",
    "evidenceRefs",
    "risk",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "track-result"
      ]
    },
    "trackResultId": { "type": "string" },
    "evidenceBundleRef": { "type": "string" },
    "trackType": {
      "type": "string",
      "enum": [
        "vlm_direct",
        "ocr_layout_solver",
        "rule_validator"
      ]
    },
    "candidateSourceType": {
      "type": "string",
      "enum": [
        "reference_placeholder",
        "historical_candidate",
        "generated",
        "perturbed_negative"
      ]
    },
    "answerCandidate": { "type": "string" },
    "confidence": { "type": "number" },
    "visualDetailMode": {
      "type": "string",
      "enum": [
        "low",
        "high",
        "original",
        "not_applicable"
      ]
    },
    "requestedVisualDetailMode": {
      "type": "string",
      "enum": [
        "low",
        "high",
        "original",
        "not_applicable"
      ]
    },
    "providerVisualDetailMode": {
      "type": "string",
      "enum": [
        "low",
        "high",
        "original",
        "not_applicable"
      ]
    },
    "stageArtifactRefs": {
      "type": "object",
      "properties": {
        "visualInputBundleRef": { "type": "string" },
        "groundingSnapshotRef": { "type": "string" },
        "solutionSnapshotRef": { "type": "string" },
        "consistencyReportRef": { "type": "string" }
      },
      "additionalProperties": true
    },
    "questionBinding": {
      "type": "object",
      "required": ["status", "questionId", "questionRef", "questionAuthoritySha256", "evidenceBundleRef"],
      "properties": {
        "status": { "enum": ["exact", "ambiguous", "missing"] },
        "questionId": { "type": "string" },
        "questionRef": { "type": "string" },
        "questionAuthoritySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidenceBundleRef": { "type": "string" }
      },
      "additionalProperties": true
    },
    "interpretation": {
      "type": "object",
      "required": ["quantityKind", "numericValue", "unitId", "unitSymbol", "semanticRole", "interpretationMode"],
      "properties": {
        "quantityKind": { "type": "string" },
        "numericValue": { "type": "string" },
        "unitId": { "type": "string" },
        "unitSymbol": { "type": "string" },
        "semanticRole": { "type": "string" },
        "interpretationMode": { "type": "string" }
      },
      "additionalProperties": true
    },
    "answerCandidateProvenance": {
      "type": "object",
      "required": [
        "sourceType", "sourceRequestSha256", "questionAuthoritySha256",
        "evidenceBundleSha256", "semanticProjectionSha256", "solverPolicySha256"
      ],
      "additionalProperties": true
    },
    "solverProvenance": {
      "type": "object",
      "required": ["engineKind", "engineId", "engineVersion", "liveProvider", "cloudEgress"],
      "additionalProperties": true
    },
    "reviewDisposition": {
      "type": "object",
      "required": [
        "status", "reasonCodes", "humanApproved", "trusted", "visualReviewPassed",
        "controlsDisposition", "eligible", "optimizationCandidateRefs"
      ],
      "properties": {
        "status": { "enum": ["review_required", "accepted"] },
        "reasonCodes": { "type": "array", "items": { "type": "string" } },
        "humanApproved": { "type": "boolean" },
        "trusted": { "type": "boolean" },
        "visualReviewPassed": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "controlsDisposition": { "type": "string" },
        "eligible": { "type": "boolean" },
        "optimizationCandidateRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "visibleEvidenceSummary": { "type": "string" },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflictRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missingEvidenceRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validatorFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "findingId",
          "severity",
          "message"
        ],
        "properties": {
          "findingId": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "blocking"
            ]
          },
          "message": { "type": "string" },
          "evidenceRef": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "level",
        "reviewRequired"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reviewRequired": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "generatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
