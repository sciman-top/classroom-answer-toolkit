{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-ocr-observation-request/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualOcrObservationRequest",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind",
    "dataClassification", "preprocessingResult", "crop",
    "structureExtractionResult", "runtimePolicy", "egressPolicy", "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-ocr-observation-request" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": {
      "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"]
    },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": {
      "type": "object",
      "required": ["level", "notes"],
      "properties": {
        "level": { "const": "public" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "preprocessingResult": { "$ref": "#/$defs/upstreamResult" },
    "crop": { "$ref": "#/$defs/crop" },
    "structureExtractionResult": { "$ref": "#/$defs/upstreamResult" },
    "runtimePolicy": { "$ref": "#/$defs/runtimePolicy" },
    "egressPolicy": {
      "type": "object",
      "required": ["allowCloud"],
      "properties": { "allowCloud": { "const": false } },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "upstreamResult": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["artifactRef", "scale", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "scale": { "const": 2 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtimePolicy": {
      "type": "object",
      "required": ["engineId", "engineVersion", "executionProvider", "interpreter", "components", "artifacts", "parameters"],
      "properties": {
        "engineId": { "const": "rapidocr-onnxruntime" },
        "engineVersion": { "const": "1.2.3" },
        "executionProvider": { "const": "CPUExecutionProvider" },
        "interpreter": {
          "type": "object",
          "required": ["implementation", "version"],
          "properties": {
            "implementation": { "const": "CPython" },
            "version": { "const": "3.13.7" }
          },
          "additionalProperties": false
        },
        "components": {
          "type": "object",
          "required": ["onnxruntime", "opencv", "pillow", "numpy", "pyyaml", "pyclipper", "shapely", "six"],
          "properties": {
            "onnxruntime": { "const": "1.27.0" },
            "opencv": { "const": "5.0.0" },
            "pillow": { "const": "12.3.0" },
            "numpy": { "const": "2.5.0" },
            "pyyaml": { "const": "6.0.3" },
            "pyclipper": { "const": "1.4.0" },
            "shapely": { "const": "2.1.2" },
            "six": { "const": "1.17.0" }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "object",
          "required": ["configSha256", "detectionModelSha256", "classificationModelSha256", "recognitionModelSha256"],
          "properties": {
            "configSha256": { "const": "a61ac7c6f753b9840ae77306f31a4845788c530d8ebe950f0c5476e30b984917" },
            "detectionModelSha256": { "const": "3439588c030faea393a54515f51e983d8e155b19a2e8aba7891934c1cf0de526" },
            "classificationModelSha256": { "const": "e47acedf663230f8863ff1ab0e64dd2d82b838fceb5957146dab185a89d6215c" },
            "recognitionModelSha256": { "const": "897a3ededb38fee0dae2c1ccee38241f37df202c9509e3abca02e9217c5ee615" }
          },
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "required": ["inputMode", "preprocessMode", "boxThreshold", "unclipRatio", "textScore", "useTextDetection", "useAngleClassification"],
          "properties": {
            "inputMode": { "const": "whole_crop" },
            "preprocessMode": { "const": "none" },
            "boxThreshold": { "const": 0.5 },
            "unclipRatio": { "const": 1.6 },
            "textScore": { "const": 0.5 },
            "useTextDetection": { "const": true },
            "useAngleClassification": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
