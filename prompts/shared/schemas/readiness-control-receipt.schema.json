{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/readiness-control-receipt/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "ReadinessControlReceipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "receiptId",
    "sourceRevision",
    "sourceTreeCleanBefore",
    "sourceTreeCleanAfter",
    "startedAt",
    "completedAt",
    "gateSequence",
    "cloudEgress",
    "verdict"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["readiness-control-receipt"]
    },
    "receiptId": {
      "type": "string",
      "pattern": "^readiness-control-[a-f0-9]{16}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceTreeCleanBefore": { "type": "boolean" },
    "sourceTreeCleanAfter": { "type": "boolean" },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "gateSequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gateId",
          "command",
          "exitCode",
          "logRef",
          "logSha256"
        ],
        "properties": {
          "gateId": { "type": "string" },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "logRef": { "type": "string", "minLength": 1 },
          "logSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "cloudEgress": {
      "type": "object",
      "required": [
        "environmentForcedDisabled",
        "liveProbesRun",
        "scope"
      ],
      "properties": {
        "environmentForcedDisabled": { "type": "boolean" },
        "liveProbesRun": { "type": "boolean" },
        "scope": {
          "type": "string",
          "enum": ["controlled_gate_processes_only"]
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": ["passed", "failed"]
    }
  },
  "additionalProperties": false
}
