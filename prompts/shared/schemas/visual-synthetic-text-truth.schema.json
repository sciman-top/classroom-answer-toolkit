{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-synthetic-text-truth/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualSyntheticTextTruth",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "truthId", "caseId", "subjectPack", "fixtureKind",
    "dataClassification", "renderer", "preprocessingResult", "source", "crop",
    "coordinateSpace", "labels", "truthProvenance", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-synthetic-text-truth" },
    "truthId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "subjectPack": {
      "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"]
    },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": {
      "type": "object",
      "required": ["level", "notes"],
      "properties": {
        "level": { "const": "public" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "renderer": { "$ref": "#/$defs/artifact" },
    "preprocessingResult": { "$ref": "#/$defs/upstreamResult" },
    "source": { "$ref": "#/$defs/imageArtifact" },
    "crop": { "$ref": "#/$defs/crop" },
    "coordinateSpace": { "const": "crop_pixel" },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["labelId", "text", "sourceBounds", "visibilityDisposition"],
        "properties": {
          "labelId": { "type": "string", "pattern": "^truth-label-[0-9]{3}$" },
          "text": { "type": "string", "minLength": 1 },
          "sourceBounds": { "$ref": "#/$defs/bounds" },
          "cropIntersectionBounds": { "$ref": "#/$defs/bounds" },
          "visibilityDisposition": {
            "enum": ["fully_visible", "partially_clipped", "outside_crop"]
          }
        },
        "additionalProperties": false
      }
    },
    "truthProvenance": {
      "type": "object",
      "required": [
        "authorityKind", "declarationSource", "interpreter", "pillowVersion",
        "liveProvider", "cloudEgress"
      ],
      "properties": {
        "authorityKind": { "const": "generator_declared_synthetic" },
        "declarationSource": { "const": "renderer_text_declarations" },
        "interpreter": {
          "type": "object",
          "required": ["implementation", "version"],
          "properties": {
            "implementation": { "const": "CPython" },
            "version": { "const": "3.13.7" }
          },
          "additionalProperties": false
        },
        "pillowVersion": { "const": "12.3.0" },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "upstreamResult": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "imageArtifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pixelSize": { "$ref": "#/$defs/pixelSize" }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": [
        "artifactRef", "scale", "rawByteSha256", "decodedRgbPixelSha256",
        "pixelSize", "sourceBounds"
      ],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "scale": { "const": 2 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pixelSize": { "$ref": "#/$defs/pixelSize" },
        "sourceBounds": { "$ref": "#/$defs/bounds" }
      },
      "additionalProperties": false
    },
    "pixelSize": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
