{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-region-semantics-request/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualRegionSemanticsRequest",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "dataClassification",
    "semanticDeclaration", "regionProposalResult", "localCropResult", "egressPolicy", "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-region-semantics-request" },
    "requestId": { "const": "junior-readable-measurement-region-semantics" },
    "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": {
      "type": "object",
      "required": ["level", "containsPersonalData"],
      "properties": {
        "level": { "const": "public" },
        "containsPersonalData": { "const": false }
      },
      "additionalProperties": false
    },
    "semanticDeclaration": { "$ref": "#/$defs/declarationArtifact" },
    "regionProposalResult": { "$ref": "#/$defs/upstreamArtifact" },
    "localCropResult": { "$ref": "#/$defs/upstreamArtifact" },
    "egressPolicy": {
      "type": "object",
      "required": ["allowCloud"],
      "properties": { "allowCloud": { "const": false } },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "declarationArtifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "declarationId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "declarationId": { "const": "junior-readable-measurement-region-semantics-declaration" }
      },
      "additionalProperties": false
    },
    "upstreamArtifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId", "proposalRefs"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "requestId": { "type": "string", "minLength": 1 },
        "proposalRefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "pattern": "^content-block-[0-9]{3}$" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
