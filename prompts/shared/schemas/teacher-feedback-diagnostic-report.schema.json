{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/teacher-feedback-diagnostic-report/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "TeacherFeedbackDiagnosticReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "reportId",
    "fixtureSetId",
    "sourceInventoryRef",
    "sourceInventorySha256",
    "resultBindings",
    "totals",
    "errorTypeCounts",
    "severityCounts",
    "reasonCodeCounts",
    "optimizationCandidateRefs",
    "stopReason"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "kind": {
      "type": "string",
      "enum": ["teacher-feedback-diagnostic-report"]
    },
    "reportId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "fixtureSetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceInventoryRef": {
      "type": "string",
      "enum": ["teacher-feedback-fixture-inventory.json"]
    },
    "sourceInventorySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resultBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["fixtureId", "resultRef", "resultSha256", "parseDisposition"],
        "properties": {
          "fixtureId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "resultRef": { "type": "string", "minLength": 1 },
          "resultSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parseDisposition": {
            "type": "string",
            "enum": ["parsed", "needs_human_label"]
          }
        },
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "totalSubmissions",
        "parsedCount",
        "needsHumanLabelCount",
        "structuredRate",
        "humanLabelRate"
      ],
      "properties": {
        "totalSubmissions": { "type": "integer", "minimum": 1 },
        "parsedCount": { "type": "integer", "minimum": 0 },
        "needsHumanLabelCount": { "type": "integer", "minimum": 0 },
        "structuredRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "humanLabelRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "errorTypeCounts": {
      "$ref": "#/$defs/errorTypeCounts"
    },
    "severityCounts": {
      "$ref": "#/$defs/severityCounts"
    },
    "reasonCodeCounts": {
      "$ref": "#/$defs/reasonCodeCounts"
    },
    "optimizationCandidateRefs": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "stopReason": {
      "type": "string",
      "enum": ["teacher_feedback_diagnostic_only_no_optimizer"]
    }
  },
  "$defs": {
    "errorTypeCounts": {
      "type": "object",
      "required": [
        "spec_gap",
        "rule_gap",
        "routing_error",
        "visual_error",
        "ocr_error",
        "reference_parse_error",
        "reasoning_error",
        "format_error",
        "data_quality_issue"
      ],
      "properties": {
        "spec_gap": { "type": "integer", "minimum": 0 },
        "rule_gap": { "type": "integer", "minimum": 0 },
        "routing_error": { "type": "integer", "minimum": 0 },
        "visual_error": { "type": "integer", "minimum": 0 },
        "ocr_error": { "type": "integer", "minimum": 0 },
        "reference_parse_error": { "type": "integer", "minimum": 0 },
        "reasoning_error": { "type": "integer", "minimum": 0 },
        "format_error": { "type": "integer", "minimum": 0 },
        "data_quality_issue": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "severityCounts": {
      "type": "object",
      "required": ["low", "medium", "high", "critical"],
      "properties": {
        "low": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "reasonCodeCounts": {
      "type": "object",
      "required": [
        "missing_error_signal",
        "ambiguous_error_signal",
        "negated_error_signal",
        "missing_severity_signal",
        "ambiguous_severity_signal"
      ],
      "properties": {
        "missing_error_signal": { "type": "integer", "minimum": 0 },
        "ambiguous_error_signal": { "type": "integer", "minimum": 0 },
        "negated_error_signal": { "type": "integer", "minimum": 0 },
        "missing_severity_signal": { "type": "integer", "minimum": 0 },
        "ambiguous_severity_signal": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
