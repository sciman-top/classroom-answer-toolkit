{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-page-normalization-result/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualPageNormalizationResult",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "sourceRequestSha256",
    "capture", "pageDetection", "corrections", "normalizedPage", "normalizedArtifact", "engineProvenance",
    "dispositions", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-page-normalization-result" },
    "requestId": { "type": "string" },
    "subjectPack": { "type": "string" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceRequestSha256": { "$ref": "#/$defs/sha256" },
    "capture": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string" },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "decodedRgbPixelSha256": { "$ref": "#/$defs/sha256" },
        "pixelSize": {
          "type": "object", "required": ["width", "height"],
          "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pageDetection": {
      "type": "object",
      "required": ["status", "quadrilateral", "areaRatio", "orientationDegrees"],
      "properties": {
        "status": { "const": "detected" },
        "quadrilateral": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "additionalProperties": false
          }
        },
        "areaRatio": { "type": "number", "minimum": 0.25, "maximum": 1 },
        "orientationDegrees": { "type": "number" }
      },
      "additionalProperties": false
    },
    "corrections": {
      "type": "object",
      "required": ["orientationDegrees", "deskewApplied", "denoiseApplied", "trimApplied", "perspectiveCorrectionApplied"],
      "properties": {
        "orientationDegrees": { "type": "number" },
        "deskewApplied": { "const": true },
        "denoiseApplied": { "const": true },
        "trimApplied": { "const": true },
        "perspectiveCorrectionApplied": { "const": true }
      },
      "additionalProperties": false
    },
    "normalizedPage": { "$ref": "normalized-page.schema.json" },
    "normalizedArtifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string" },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "decodedRgbPixelSha256": { "$ref": "#/$defs/sha256" },
        "pixelSize": {
          "type": "object", "required": ["width", "height"],
          "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "engineProvenance": {
      "type": "object",
      "required": ["engineKind", "engineId", "engineVersion", "components", "fixtureSourceRef", "fixtureSourceSha256", "liveProvider", "cloudEgress"],
      "properties": {
        "engineKind": { "const": "local_runtime" },
        "engineId": { "const": "deterministic-visual-page-normalizer" },
        "engineVersion": { "const": "1.0.0" },
        "components": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "required": ["name", "version"],
            "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "fixtureSourceRef": { "type": "string" },
        "fixtureSourceSha256": { "$ref": "#/$defs/sha256" },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "dispositions": {
      "type": "object",
      "required": ["scope", "requiresHumanReview", "acceptanceDisposition", "controlsDisposition", "eligible", "optimizationCandidateRefs"],
      "properties": {
        "scope": { "const": "public_synthetic_page_normalization" },
        "requiresHumanReview": { "const": true },
        "acceptanceDisposition": { "const": "not_accepted" },
        "controlsDisposition": { "const": "not_verified" },
        "eligible": { "const": false },
        "optimizationCandidateRefs": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
  "additionalProperties": false
}
