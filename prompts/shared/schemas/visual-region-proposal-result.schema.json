{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-region-proposal-result/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualRegionProposalResult",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "sourceRequestSha256",
    "normalizationResult", "normalizedArtifact", "coordinateSpace", "regionProposalCandidates",
    "summary", "diagnosticOverlay", "algorithmParameters", "engineProvenance", "dispositions",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-region-proposal-result" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceRequestSha256": { "$ref": "#/$defs/sha256" },
    "normalizationResult": { "$ref": "#/$defs/normalizationResult" },
    "normalizedArtifact": { "$ref": "#/$defs/artifact" },
    "coordinateSpace": { "const": "normalized_page_pixel" },
    "regionProposalCandidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "proposalId", "proposalKind", "bbox", "sourceComponentBounds", "foregroundArea",
          "bboxArea", "foregroundCoverageRatio", "touchesPageBoundary", "heuristicOnly"
        ],
        "properties": {
          "proposalId": { "type": "string", "pattern": "^content-block-[0-9]{3}$" },
          "proposalKind": { "const": "content_block_candidate" },
          "bbox": { "$ref": "#/$defs/bbox" },
          "sourceComponentBounds": { "$ref": "#/$defs/bbox" },
          "foregroundArea": { "type": "integer", "minimum": 1 },
          "bboxArea": { "type": "integer", "minimum": 1 },
          "foregroundCoverageRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "touchesPageBoundary": { "type": "boolean" },
          "heuristicOnly": { "const": true }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["proposalCount", "boundaryTouchingCount"],
      "properties": {
        "proposalCount": { "type": "integer", "minimum": 1, "maximum": 16 },
        "boundaryTouchingCount": { "type": "integer", "minimum": 0, "maximum": 16 }
      },
      "additionalProperties": false
    },
    "diagnosticOverlay": {
      "type": "object",
      "required": [
        "artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize",
        "authorityDisposition"
      ],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "decodedRgbPixelSha256": { "$ref": "#/$defs/sha256" },
        "pixelSize": { "$ref": "#/$defs/pixelSize" },
        "authorityDisposition": { "const": "diagnostic_only" }
      },
      "additionalProperties": false
    },
    "algorithmParameters": {
      "type": "object",
      "required": ["policySha256"],
      "properties": { "policySha256": { "$ref": "#/$defs/sha256" } },
      "additionalProperties": false
    },
    "engineProvenance": {
      "type": "object",
      "required": ["engineKind", "engineId", "engineVersion", "components", "liveProvider", "cloudEgress"],
      "properties": {
        "engineKind": { "const": "local_runtime" },
        "engineId": { "const": "deterministic-visual-region-proposer" },
        "engineVersion": { "const": "1.0.0" },
        "components": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "dispositions": {
      "type": "object",
      "required": [
        "proposalStatus", "semanticDisposition", "visualRegionDisposition", "requiresHumanReview",
        "acceptanceDisposition", "controlsDisposition", "eligible", "optimizationCandidateRefs"
      ],
      "properties": {
        "proposalStatus": { "const": "completed" },
        "semanticDisposition": { "const": "not_inferred" },
        "visualRegionDisposition": { "const": "not_generated" },
        "requiresHumanReview": { "const": true },
        "acceptanceDisposition": { "const": "not_accepted" },
        "controlsDisposition": { "const": "not_verified" },
        "eligible": { "const": false },
        "optimizationCandidateRefs": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pixelSize": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "normalizationResult": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId", "pageId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "requestId": { "type": "string", "minLength": 1 },
        "pageId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "decodedRgbPixelSha256": { "$ref": "#/$defs/sha256" },
        "pixelSize": { "$ref": "#/$defs/pixelSize" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
