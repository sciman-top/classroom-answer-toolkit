{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-risk-case-inventory/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "VisualRiskCaseInventory",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "fixtureSetId",
    "fixtureType",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-risk-case-inventory" },
    "fixtureSetId": { "type": "string", "minLength": 1 },
    "fixtureType": { "const": "synthetic_fixture" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "subjectPack",
          "riskCategory",
          "expectedReview",
          "expectedBinding",
          "expectedOcrImageConflict",
          "decisionGeneratedAt",
          "evidenceBundleRef",
          "evidenceBundleSha256",
          "trackResultBindings",
          "expectedDecisionRef",
          "expectedDecisionSha256"
        ],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "subjectPack": {
            "enum": [
              "math-answer",
              "junior-physics-answer",
              "senior-physics-answer"
            ]
          },
          "riskCategory": { "type": "string", "minLength": 1 },
          "expectedReview": { "const": true },
          "expectedBinding": {
            "type": "object",
            "required": [
              "status",
              "questionRef",
              "figureRefs",
              "cropRefs",
              "evidenceRefs"
            ],
            "properties": {
              "status": { "enum": ["stable", "ambiguous", "missing"] },
              "questionRef": { "type": "string", "minLength": 1 },
              "figureRefs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "cropRefs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          },
          "expectedOcrImageConflict": { "type": "boolean" },
          "decisionGeneratedAt": { "type": "string", "format": "date-time" },
          "evidenceBundleRef": { "type": "string", "minLength": 1 },
          "evidenceBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "trackResultBindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["trackType", "trackResultRef", "trackResultSha256"],
              "properties": {
                "trackType": {
                  "enum": ["vlm_direct", "ocr_layout_solver", "rule_validator"]
                },
                "trackResultRef": { "type": "string", "minLength": 1 },
                "trackResultSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          },
          "expectedDecisionRef": { "type": "string", "minLength": 1 },
          "expectedDecisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
