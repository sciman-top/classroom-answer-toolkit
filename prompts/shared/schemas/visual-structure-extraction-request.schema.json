{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-structure-extraction-request/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualStructureExtractionRequest",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "requestId",
    "subjectPack",
    "fixtureKind",
    "dataClassification",
    "preprocessingResult",
    "crop",
    "extractionPolicy",
    "egressPolicy",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-structure-extraction-request" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": {
      "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"]
    },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": {
      "type": "object",
      "required": ["level", "notes"],
      "properties": {
        "level": { "const": "public" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "preprocessingResult": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": [
        "artifactRef",
        "scale",
        "rawByteSha256",
        "decodedRgbPixelSha256",
        "pixelSize"
      ],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "scale": { "const": 2 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extractionPolicy": {
      "type": "object",
      "required": [
        "binaryThreshold",
        "connectedComponents",
        "canny",
        "houghLinesP",
        "textCandidateHeuristic"
      ],
      "properties": {
        "binaryThreshold": {
          "type": "object",
          "required": ["value", "mode"],
          "properties": {
            "value": { "const": 200 },
            "mode": { "const": "binary_inverted" }
          },
          "additionalProperties": false
        },
        "connectedComponents": {
          "type": "object",
          "required": ["connectivity", "minimumArea"],
          "properties": {
            "connectivity": { "const": 8 },
            "minimumArea": { "const": 8 }
          },
          "additionalProperties": false
        },
        "canny": {
          "type": "object",
          "required": ["threshold1", "threshold2", "apertureSize", "l2Gradient"],
          "properties": {
            "threshold1": { "const": 50 },
            "threshold2": { "const": 150 },
            "apertureSize": { "const": 3 },
            "l2Gradient": { "const": false }
          },
          "additionalProperties": false
        },
        "houghLinesP": {
          "type": "object",
          "required": ["rho", "thetaDegrees", "threshold", "minimumLineLength", "maximumLineGap"],
          "properties": {
            "rho": { "const": 1 },
            "thetaDegrees": { "const": 1 },
            "threshold": { "const": 30 },
            "minimumLineLength": { "const": 20 },
            "maximumLineGap": { "const": 4 }
          },
          "additionalProperties": false
        },
        "textCandidateHeuristic": {
          "type": "object",
          "required": ["minimumArea", "maximumArea", "maximumWidth", "maximumHeight"],
          "properties": {
            "minimumArea": { "const": 8 },
            "maximumArea": { "const": 200 },
            "maximumWidth": { "const": 20 },
            "maximumHeight": { "const": 20 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "egressPolicy": {
      "type": "object",
      "required": ["allowCloud"],
      "properties": { "allowCloud": { "const": false } },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
