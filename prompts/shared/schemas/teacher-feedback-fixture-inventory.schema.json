{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/teacher-feedback-fixture-inventory/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "TeacherFeedbackFixtureInventory",
  "type": "object",
  "required": ["schemaVersion", "kind", "fixtureSetId", "entries"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "kind": {
      "type": "string",
      "enum": ["teacher-feedback-fixture-inventory"]
    },
    "fixtureSetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "fixtureId",
          "submissionRef",
          "submissionSha256",
          "resultRef",
          "resultSha256"
        ],
        "properties": {
          "fixtureId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "submissionRef": { "type": "string", "minLength": 1 },
          "submissionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "resultRef": { "type": "string", "minLength": 1 },
          "resultSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
