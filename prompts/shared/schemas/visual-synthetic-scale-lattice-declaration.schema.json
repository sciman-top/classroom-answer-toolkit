{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-synthetic-scale-lattice-declaration/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualSyntheticScaleLatticeDeclaration",
  "type": "object",
  "required": ["schemaVersion", "kind", "declarationId", "caseId", "subjectPack", "fixtureKind", "dataClassification", "axis", "coordinateMetric", "pointerComponentRef", "majorTickComponentRefs", "subdivisionsPerMajorInterval", "minorTickSlots", "geometryToleranceDoubledPixels", "authorityProvenance", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-synthetic-scale-lattice-declaration" },
    "declarationId": { "const": "junior-instrument-scale-lattice-declaration" },
    "caseId": { "const": "junior-instrument-scale" },
    "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": { "$ref": "#/$defs/dataClassification" },
    "axis": { "const": "horizontal" },
    "coordinateMetric": { "const": "inclusive_bbox_center_doubled_pixels" },
    "pointerComponentRef": { "const": "scale-component-001" },
    "majorTickComponentRefs": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "pattern": "^scale-component-[0-9]{3}$" } },
    "subdivisionsPerMajorInterval": { "const": 5 },
    "minorTickSlots": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "$ref": "#/$defs/minorSlot" } },
    "geometryToleranceDoubledPixels": { "const": 1 },
    "authorityProvenance": {
      "type": "object",
      "required": ["authorityKind", "inferencePerformed", "liveProvider", "cloudEgress"],
      "properties": {
        "authorityKind": { "const": "explicit_synthetic_scale_lattice_declaration" },
        "inferencePerformed": { "const": false },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "dataClassification": { "type": "object", "required": ["level", "containsPersonalData"], "properties": { "level": { "const": "public" }, "containsPersonalData": { "const": false } }, "additionalProperties": false },
    "minorSlot": { "type": "object", "required": ["regionRef", "slotIndex"], "properties": { "regionRef": { "pattern": "^region-[0-9]{3}$" }, "slotIndex": { "type": "integer", "enum": [1, 2, 3, 4, 6, 7, 8, 9, 12, 13, 14, 16, 17, 18, 19] } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
