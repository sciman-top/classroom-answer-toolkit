{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-spatial-observation-result/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualSpatialObservationResult",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind",
    "sourceRequestSha256", "structureExtractionResult", "ocrObservationResult",
    "crop", "coordinateSpace", "measurements", "summary", "dispositions",
    "geometryPolicySha256", "engineProvenance", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-spatial-observation-result" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": {
      "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"]
    },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceRequestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "structureExtractionResult": { "$ref": "#/$defs/upstreamResult" },
    "ocrObservationResult": { "$ref": "#/$defs/upstreamResult" },
    "crop": { "$ref": "#/$defs/crop" },
    "coordinateSpace": { "const": "crop_pixel" },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "measurementId", "textRegionCandidateRef", "ocrObservationRef",
          "ocrAxisAlignedBounds", "intersectionArea",
          "intersectionOverTextRegionAreaRatio", "intersectionOverOcrBoundsAreaRatio",
          "centroidDistanceSquared", "spatialRelation"
        ],
        "properties": {
          "measurementId": { "type": "string", "pattern": "^spatial-measurement-[0-9]{3}$" },
          "textRegionCandidateRef": { "type": "string", "pattern": "^text-region-[0-9]{3}$" },
          "ocrObservationRef": { "type": "string", "pattern": "^ocr-observation-[0-9]{3}$" },
          "ocrAxisAlignedBounds": { "$ref": "#/$defs/numericBounds" },
          "intersectionArea": { "type": "number", "minimum": 0 },
          "intersectionOverTextRegionAreaRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "intersectionOverOcrBoundsAreaRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "centroidDistanceSquared": { "type": "number", "minimum": 0 },
          "spatialRelation": {
            "enum": [
              "equal_bounds", "observation_contains_region", "region_contains_observation",
              "overlap", "disjoint"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "textRegionCandidateCount", "ocrObservationCount", "expectedPairCount",
        "measurementCount", "relationCounts"
      ],
      "properties": {
        "textRegionCandidateCount": { "type": "integer", "minimum": 0 },
        "ocrObservationCount": { "type": "integer", "minimum": 0 },
        "expectedPairCount": { "type": "integer", "minimum": 0 },
        "measurementCount": { "type": "integer", "minimum": 0 },
        "relationCounts": {
          "type": "object",
          "required": [
            "equal_bounds", "observation_contains_region", "region_contains_observation",
            "overlap", "disjoint"
          ],
          "properties": {
            "equal_bounds": { "type": "integer", "minimum": 0 },
            "observation_contains_region": { "type": "integer", "minimum": 0 },
            "region_contains_observation": { "type": "integer", "minimum": 0 },
            "overlap": { "type": "integer", "minimum": 0 },
            "disjoint": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dispositions": {
      "type": "object",
      "required": [
        "measurementStatus", "associationDisposition", "layoutDisposition",
        "semanticDisposition", "trackDisposition", "requiresHumanReview"
      ],
      "properties": {
        "measurementStatus": { "const": "completed" },
        "associationDisposition": { "const": "not_decided" },
        "layoutDisposition": { "const": "not_inferred" },
        "semanticDisposition": { "const": "not_inferred" },
        "trackDisposition": { "const": "not_integrated" },
        "requiresHumanReview": { "const": true }
      },
      "additionalProperties": false
    },
    "geometryPolicySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "engineProvenance": {
      "type": "object",
      "required": [
        "engineKind", "engineId", "engineVersion", "interpreter",
        "liveProvider", "cloudEgress"
      ],
      "properties": {
        "engineKind": { "const": "deterministic_geometry" },
        "engineId": { "const": "visual-spatial-observer" },
        "engineVersion": { "const": "1.0.0" },
        "interpreter": {
          "type": "object",
          "required": ["implementation", "version"],
          "properties": {
            "implementation": { "const": "CPython" },
            "version": { "const": "3.13.7" }
          },
          "additionalProperties": false
        },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "upstreamResult": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["artifactRef", "scale", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "scale": { "const": 2 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "numericBounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
