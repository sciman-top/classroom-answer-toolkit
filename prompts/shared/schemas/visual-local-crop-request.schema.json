{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-local-crop-request/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualLocalCropRequest", "type": "object",
  "required": ["schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "dataClassification", "regionProposalResult", "normalizedArtifact", "scales", "scale2Interpolation", "egressPolicy", "requestedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "kind": { "const": "visual-local-crop-request" },
    "requestId": { "type": "string" }, "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": { "type": "object", "required": ["level", "containsPersonalData"], "properties": { "level": { "const": "public" }, "containsPersonalData": { "const": false } }, "additionalProperties": false },
    "regionProposalResult": { "type": "object", "required": ["artifactRef", "rawByteSha256", "requestId", "proposalRefs"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "requestId": { "type": "string" }, "proposalRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^content-block-[0-9]{3}$" }, "uniqueItems": true } }, "additionalProperties": false },
    "normalizedArtifact": { "$ref": "#/$defs/artifact" },
    "scales": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": [1, 2] } }, "scale2Interpolation": { "const": "nearest" },
    "egressPolicy": { "type": "object", "required": ["allowCloud"], "properties": { "allowCloud": { "const": false } }, "additionalProperties": false },
    "requestedAt": { "type": "string" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": { "type": "object", "required": ["artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "decodedRgbPixelSha256": { "$ref": "#/$defs/sha" }, "pixelSize": { "$ref": "#/$defs/size" } }, "additionalProperties": false },
    "size": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }
  }, "additionalProperties": false
}
