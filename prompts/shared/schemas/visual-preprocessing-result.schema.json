{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-preprocessing-result/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "VisualPreprocessingResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "requestId",
    "subjectPack",
    "fixtureKind",
    "sourceRequestSha256",
    "source",
    "normalizedPage",
    "visualRegion",
    "cropArtifacts",
    "engineProvenance",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-preprocessing-result" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": {
      "enum": [
        "math-answer",
        "junior-physics-answer",
        "senior-physics-answer"
      ]
    },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceRequestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "required": [
        "artifactRef",
        "rawByteSha256",
        "decodedRgbPixelSha256",
        "pixelSize"
      ],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "normalizedPage": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "pageId",
        "sourceDocument",
        "sourceKind",
        "pageNumber",
        "imagePath",
        "pixelSize",
        "dpi",
        "renderScales",
        "preprocessing",
        "regionRefs",
        "generatedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "normalized-page" },
        "pageId": { "type": "string", "minLength": 1 },
        "sourceDocument": { "type": "string", "minLength": 1 },
        "sourceKind": { "const": "image" },
        "pageNumber": { "const": 1 },
        "imagePath": { "type": "string", "minLength": 1 },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "dpi": { "type": "number", "exclusiveMinimum": 0 },
        "renderScales": {
          "type": "array",
          "prefixItems": [{ "const": 1 }, { "const": 2 }],
          "minItems": 2,
          "maxItems": 2
        },
        "preprocessing": {
          "type": "object",
          "required": [
            "orientationDegrees",
            "deskewApplied",
            "denoiseApplied",
            "trimApplied",
            "perspectiveCorrectionApplied"
          ],
          "properties": {
            "orientationDegrees": { "const": 0 },
            "deskewApplied": { "const": false },
            "denoiseApplied": { "const": false },
            "trimApplied": { "const": false },
            "perspectiveCorrectionApplied": { "const": false }
          },
          "additionalProperties": false
        },
        "regionRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "visualRegion": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "regionId",
        "pageId",
        "regionType",
        "bbox",
        "cropRef",
        "imagePath",
        "pixelSize",
        "generatedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "visual-region" },
        "regionId": { "type": "string", "minLength": 1 },
        "pageId": { "type": "string", "minLength": 1 },
        "regionType": { "const": "crop" },
        "bbox": {
          "type": "object",
          "required": ["x", "y", "width", "height", "coordinateSpace"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "coordinateSpace": { "const": "page_pixel" }
          },
          "additionalProperties": false
        },
        "cropRef": { "type": "string", "minLength": 1 },
        "imagePath": { "type": "string", "minLength": 1 },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "cropArtifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "scale",
          "artifactRef",
          "rawByteSha256",
          "decodedRgbPixelSha256",
          "pixelSize",
          "interpolation"
        ],
        "properties": {
          "scale": { "enum": [1, 2] },
          "artifactRef": { "type": "string", "minLength": 1 },
          "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "pixelSize": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "interpolation": { "enum": ["pixel_preserving", "nearest"] }
        },
        "additionalProperties": false
      }
    },
    "engineProvenance": {
      "type": "object",
      "required": [
        "engineKind",
        "engineId",
        "engineVersion",
        "components",
        "liveProvider",
        "cloudEgress"
      ],
      "properties": {
        "engineKind": { "enum": ["local_runtime", "remote_provider"] },
        "engineId": { "type": "string", "minLength": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "liveProvider": { "type": "boolean" },
        "cloudEgress": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
