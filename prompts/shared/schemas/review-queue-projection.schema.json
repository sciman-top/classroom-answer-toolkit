{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/review-queue-projection/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "ReviewQueueProjectionResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "succeeded",
    "authority",
    "sourceCount",
    "counts",
    "items",
    "rejectedSources"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "review-queue-projection-result" },
    "succeeded": { "type": "boolean" },
    "authority": { "const": "local_verified_projection" },
    "sourceCount": { "type": "integer", "minimum": 1 },
    "counts": {
      "type": "object",
      "required": ["needsHumanLabel", "highRiskApproval", "truthNeedsReview"],
      "properties": {
        "needsHumanLabel": { "type": "integer", "minimum": 0 },
        "highRiskApproval": { "type": "integer", "minimum": 0 },
        "truthNeedsReview": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "queue",
          "artifactKind",
          "artifactId",
          "subjectPack",
          "sourcePath",
          "sourceSha256",
          "reason"
        ],
        "properties": {
          "queue": {
            "enum": ["needs_human_label", "high_risk_approval", "truth_needs_review"]
          },
          "artifactKind": {
            "enum": ["feedback-parse-result", "decision-record", "delivery-decision-aggregate"]
          },
          "artifactId": { "type": "string", "minLength": 1 },
          "subjectPack": { "type": "string", "minLength": 1 },
          "sourcePath": { "type": "string", "minLength": 1 },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "rejectedSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourcePath", "reason"],
        "properties": {
          "sourcePath": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "succeeded": { "const": true } } },
      "then": { "properties": { "rejectedSources": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "succeeded": { "const": false } } },
      "then": {
        "properties": {
          "items": { "maxItems": 0 },
          "rejectedSources": { "minItems": 1 },
          "counts": {
            "properties": {
              "needsHumanLabel": { "const": 0 },
              "highRiskApproval": { "const": 0 },
              "truthNeedsReview": { "const": 0 }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
