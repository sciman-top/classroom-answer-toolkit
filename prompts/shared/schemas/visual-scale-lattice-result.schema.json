{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-scale-lattice-result/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualScaleLatticeResult",
  "type": "object",
  "required": ["schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "sourceRequestSha256", "scaleDeclaration", "componentSemanticsResult", "structureExtractionResult", "coordinateSpace", "scaleLattice", "pointerPosition", "engineProvenance", "dispositions", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-scale-lattice-result" },
    "requestId": { "const": "junior-instrument-scale-lattice" },
    "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceRequestSha256": { "$ref": "#/$defs/sha" },
    "scaleDeclaration": { "$ref": "#/$defs/declaration" },
    "componentSemanticsResult": { "$ref": "#/$defs/componentArtifact" },
    "structureExtractionResult": { "$ref": "#/$defs/structureArtifact" },
    "coordinateSpace": { "const": "crop_pixel" },
    "scaleLattice": { "$ref": "#/$defs/lattice" },
    "pointerPosition": { "$ref": "#/$defs/pointer" },
    "engineProvenance": { "$ref": "#/$defs/provenance" },
    "dispositions": { "$ref": "#/$defs/dispositions" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "declaration": { "type": "object", "required": ["artifactRef", "rawByteSha256", "declarationId"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "declarationId": { "const": "junior-instrument-scale-lattice-declaration" } }, "additionalProperties": false },
    "componentArtifact": { "type": "object", "required": ["artifactRef", "rawByteSha256", "requestId"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "requestId": { "const": "junior-instrument-scale-component-semantics" } }, "additionalProperties": false },
    "structureArtifact": { "type": "object", "required": ["artifactRef", "rawByteSha256", "requestId"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "requestId": { "const": "junior-instrument-scale" } }, "additionalProperties": false },
    "minorSlot": { "type": "object", "required": ["regionRef", "slotIndex", "observedCenterDoubledPixels", "expectedCenterDoubledPixels", "deviationDoubledPixels"], "properties": { "regionRef": { "pattern": "^region-[0-9]{3}$" }, "slotIndex": { "type": "integer", "minimum": 1, "maximum": 19 }, "observedCenterDoubledPixels": { "type": "integer", "minimum": 0 }, "expectedCenterDoubledPixels": { "type": "integer", "minimum": 0 }, "deviationDoubledPixels": { "type": "integer", "minimum": 0, "maximum": 1 } }, "additionalProperties": false },
    "lattice": { "type": "object", "required": ["axis", "coordinateMetric", "majorTickComponentRefs", "majorCentersDoubledPixels", "majorSpacingDoubledPixels", "majorSpacingPixels", "subdivisionsPerMajorInterval", "subdivisionSpacingDoubledPixels", "subdivisionSpacingPixels", "minorTickSlots", "maxObservedDeviationDoubledPixels"], "properties": { "axis": { "const": "horizontal" }, "coordinateMetric": { "const": "inclusive_bbox_center_doubled_pixels" }, "majorTickComponentRefs": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "string" } }, "majorCentersDoubledPixels": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "integer", "minimum": 0 } }, "majorSpacingDoubledPixels": { "const": 240 }, "majorSpacingPixels": { "const": 120 }, "subdivisionsPerMajorInterval": { "const": 5 }, "subdivisionSpacingDoubledPixels": { "const": 48 }, "subdivisionSpacingPixels": { "const": 24 }, "minorTickSlots": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "$ref": "#/$defs/minorSlot" } }, "maxObservedDeviationDoubledPixels": { "const": 1 } }, "additionalProperties": false },
    "pointer": { "type": "object", "required": ["componentRef", "centerDoubledPixels", "expectedCenterDoubledPixels", "alignmentDeviationDoubledPixels", "relativeSubdivisionIndex", "valueSemantics", "physicalQuantity", "unit"], "properties": { "componentRef": { "const": "scale-component-001" }, "centerDoubledPixels": { "const": 606 }, "expectedCenterDoubledPixels": { "const": 606 }, "alignmentDeviationDoubledPixels": { "const": 0 }, "relativeSubdivisionIndex": { "const": 11 }, "valueSemantics": { "const": "relative_subdivision_index" }, "physicalQuantity": { "type": "null" }, "unit": { "type": "null" } }, "additionalProperties": false },
    "provenance": { "type": "object", "required": ["engineKind", "engineId", "engineVersion", "inferencePerformed", "liveProvider", "cloudEgress"], "properties": { "engineKind": { "const": "local_runtime" }, "engineId": { "const": "deterministic-explicit-scale-lattice-compiler" }, "engineVersion": { "const": "1.0.0" }, "inferencePerformed": { "const": false }, "liveProvider": { "const": false }, "cloudEgress": { "const": false } }, "additionalProperties": false },
    "dispositions": { "type": "object", "required": ["semanticDisposition", "scaleInterpretationDisposition", "readingDisposition", "physicalReadingDisposition", "quantityInterpretationDisposition", "unitInterpretationDisposition", "figureUnderstandingDisposition", "questionBindingDisposition", "trackDisposition", "answerDisposition", "requiresHumanReview", "acceptanceDisposition", "controlsDisposition", "eligible", "optimizationCandidateRefs"], "properties": { "semanticDisposition": { "const": "explicit_declared_and_geometry_derived" }, "scaleInterpretationDisposition": { "const": "relative_lattice_only" }, "readingDisposition": { "const": "relative_index_only" }, "physicalReadingDisposition": { "const": "not_generated" }, "quantityInterpretationDisposition": { "const": "not_established" }, "unitInterpretationDisposition": { "const": "not_established" }, "figureUnderstandingDisposition": { "const": "partial_scale_lattice_only" }, "questionBindingDisposition": { "const": "not_established" }, "trackDisposition": { "const": "not_integrated" }, "answerDisposition": { "const": "not_generated" }, "requiresHumanReview": { "const": true }, "acceptanceDisposition": { "const": "not_accepted" }, "controlsDisposition": { "const": "not_verified" }, "eligible": { "const": false }, "optimizationCandidateRefs": { "type": "array", "maxItems": 0 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
