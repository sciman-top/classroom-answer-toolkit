{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-component-semantics-request/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualComponentSemanticsRequest",
  "type": "object",
  "required": ["schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "dataClassification", "componentDeclaration", "structureExtractionResult", "preprocessingResult", "crop", "egressPolicy", "requestedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "kind": { "const": "visual-component-semantics-request" },
    "requestId": { "const": "junior-instrument-scale-component-semantics" },
    "subjectPack": { "const": "junior-physics-answer" }, "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": { "$ref": "#/$defs/dataClassification" },
    "componentDeclaration": { "$ref": "#/$defs/declaration" },
    "structureExtractionResult": { "$ref": "#/$defs/artifact" },
    "preprocessingResult": { "$ref": "#/$defs/artifact" },
    "crop": { "$ref": "#/$defs/crop" },
    "egressPolicy": { "type": "object", "required": ["allowCloud"], "properties": { "allowCloud": { "const": false } }, "additionalProperties": false },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dataClassification": { "type": "object", "required": ["level", "containsPersonalData"], "properties": { "level": { "const": "public" }, "containsPersonalData": { "const": false } }, "additionalProperties": false },
    "artifact": { "type": "object", "required": ["artifactRef", "rawByteSha256", "requestId"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "requestId": { "const": "junior-instrument-scale" } }, "additionalProperties": false },
    "declaration": { "type": "object", "required": ["artifactRef", "rawByteSha256", "declarationId"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "declarationId": { "const": "junior-instrument-scale-component-semantics-declaration" } }, "additionalProperties": false },
    "size": { "type": "object", "required": ["width", "height"], "properties": { "width": { "const": 580 }, "height": { "const": 210 } }, "additionalProperties": false },
    "crop": { "type": "object", "required": ["artifactRef", "scale", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"], "properties": { "artifactRef": { "type": "string" }, "scale": { "const": 2 }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "decodedRgbPixelSha256": { "$ref": "#/$defs/sha" }, "pixelSize": { "$ref": "#/$defs/size" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
