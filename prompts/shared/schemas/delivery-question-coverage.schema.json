{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/delivery-question-coverage/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "DeliveryQuestionCoverage",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "coverageId",
    "subjectPack",
    "deliveryBinding",
    "questionInventory",
    "expectedQuestionRefs",
    "coverageComplete",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["delivery-question-coverage"]
    },
    "coverageId": { "type": "string" },
    "subjectPack": { "type": "string" },
    "deliveryBinding": {
      "type": "object",
      "required": [
        "snapshotId",
        "snapshotSha256",
        "inputSha256",
        "manifestSha256"
      ],
      "properties": {
        "snapshotId": { "type": "string" },
        "snapshotSha256": { "type": "string" },
        "inputSha256": { "type": "string" },
        "manifestSha256": { "type": "string" }
      },
      "additionalProperties": true
    },
    "questionInventory": {
      "type": "object",
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": true
    },
    "expectedQuestionRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "coverageComplete": { "type": "boolean" },
    "generatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
