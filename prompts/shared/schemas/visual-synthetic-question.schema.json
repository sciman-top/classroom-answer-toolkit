{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-synthetic-question/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualSyntheticQuestion",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "questionId", "questionRef", "caseId", "subjectPack",
    "fixtureKind", "promptText", "figureBinding", "interpretationAuthority",
    "dataClassification", "provenance", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-synthetic-question" },
    "questionId": { "type": "string", "minLength": 1 },
    "questionRef": { "type": "string", "minLength": 1 },
    "caseId": { "const": "junior-readable-measurement" },
    "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "promptText": { "type": "string", "minLength": 1 },
    "figureBinding": {
      "type": "object",
      "required": ["cropRef", "cropRawByteSha256", "cropDecodedRgbPixelSha256"],
      "properties": {
        "cropRef": { "type": "string", "minLength": 1 },
        "cropRawByteSha256": { "$ref": "#/$defs/sha256" },
        "cropDecodedRgbPixelSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "interpretationAuthority": {
      "type": "object",
      "required": ["quantityKind", "semanticRoleRequired", "unit", "valueSource", "unitSource"],
      "properties": {
        "quantityKind": { "const": "length" },
        "semanticRoleRequired": { "const": "measurement_reading" },
        "unit": {
          "type": "object",
          "required": ["unitId", "token", "symbol"],
          "properties": {
            "unitId": { "const": "centimetre" },
            "token": { "const": "centimetres" },
            "symbol": { "const": "cm" }
          },
          "additionalProperties": false
        },
        "valueSource": { "const": "bound_semantic_projection_recognized_text" },
        "unitSource": { "const": "explicit_question_text" }
      },
      "additionalProperties": false
    },
    "dataClassification": {
      "type": "object",
      "required": ["level", "containsPersonalData"],
      "properties": {
        "level": { "const": "public" },
        "containsPersonalData": { "const": false }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["authorityKind", "liveProvider", "cloudEgress"],
      "properties": {
        "authorityKind": { "const": "explicit_synthetic_question_declaration" },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
