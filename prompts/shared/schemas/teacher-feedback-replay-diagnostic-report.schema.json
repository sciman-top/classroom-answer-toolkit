{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/teacher-feedback-replay-diagnostic-report/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "TeacherFeedbackReplayDiagnosticReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "reportId",
    "fixtureSetId",
    "sourceInventoryRef",
    "sourceInventorySha256",
    "replayBindings",
    "totals",
    "optimizationCandidateRefs",
    "stopReason"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "kind": {
      "type": "string",
      "enum": ["teacher-feedback-replay-diagnostic-report"]
    },
    "reportId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "fixtureSetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceInventoryRef": {
      "type": "string",
      "enum": ["teacher-feedback-fixture-inventory.json"]
    },
    "sourceInventorySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "replayBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "fixtureId",
          "submissionRef",
          "submissionSha256",
          "expectedResultRef",
          "expectedResultSha256",
          "replayedResultSha256",
          "replayDisposition"
        ],
        "properties": {
          "fixtureId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "submissionRef": { "type": "string", "minLength": 1 },
          "submissionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedResultRef": { "type": "string", "minLength": 1 },
          "expectedResultSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "replayedResultSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "replayDisposition": {
            "type": "string",
            "enum": ["passed", "failed"]
          }
        },
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "required": ["totalReplays", "passedCount", "failedCount", "passRate"],
      "properties": {
        "totalReplays": { "type": "integer", "minimum": 1 },
        "passedCount": { "type": "integer", "minimum": 0 },
        "failedCount": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "optimizationCandidateRefs": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "stopReason": {
      "type": "string",
      "enum": ["teacher_feedback_replay_diagnostic_only_no_optimizer"]
    }
  },
  "additionalProperties": false
}
