{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-ocr-region-association-request/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualOcrRegionAssociationRequest",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind",
    "dataClassification", "structureExtractionResult", "ocrObservationResult",
    "spatialObservationResult", "crop", "associationPolicy", "egressPolicy", "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-ocr-region-association-request" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": {
      "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"]
    },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": {
      "type": "object",
      "required": ["level", "notes"],
      "properties": {
        "level": { "const": "public" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "structureExtractionResult": { "$ref": "#/$defs/upstreamResult" },
    "ocrObservationResult": { "$ref": "#/$defs/upstreamResult" },
    "spatialObservationResult": { "$ref": "#/$defs/upstreamResult" },
    "crop": { "$ref": "#/$defs/crop" },
    "associationPolicy": {
      "type": "object",
      "required": [
        "eligibleMeasurement", "cardinality", "ambiguityDisposition",
        "zeroEndpointDisposition", "noEligibleEdgeDisposition", "ordering", "ratioPrecision"
      ],
      "properties": {
        "eligibleMeasurement": { "const": "positive_intersection_non_disjoint" },
        "cardinality": { "const": "bidirectional_unique" },
        "ambiguityDisposition": { "const": "fail_closed" },
        "zeroEndpointDisposition": { "const": "unavailable" },
        "noEligibleEdgeDisposition": { "const": "unmatched" },
        "ordering": {
          "type": "array",
          "prefixItems": [
            { "const": "text_region_candidate_id" },
            { "const": "ocr_observation_id" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "ratioPrecision": { "const": 8 }
      },
      "additionalProperties": false
    },
    "egressPolicy": {
      "type": "object",
      "required": ["allowCloud"],
      "properties": { "allowCloud": { "const": false } },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "upstreamResult": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["artifactRef", "scale", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "scale": { "const": 2 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
