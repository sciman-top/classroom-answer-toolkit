{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-semantic-projection-result/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualSemanticProjectionResult",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "sourceRequestSha256",
    "semanticDeclaration", "ocrDiagnosticReport", "textRegionDiagnosticReport",
    "associationResult", "ocrObservationResult", "crop", "coordinateSpace", "projections",
    "summary", "dispositions", "projectionPolicySha256", "engineProvenance", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-semantic-projection-result" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": { "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"] },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceRequestSha256": { "$ref": "#/$defs/sha256" },
    "semanticDeclaration": { "$ref": "#/$defs/declarationArtifact" },
    "ocrDiagnosticReport": { "$ref": "#/$defs/artifact" },
    "textRegionDiagnosticReport": { "$ref": "#/$defs/artifact" },
    "associationResult": { "$ref": "#/$defs/resultArtifact" },
    "ocrObservationResult": { "$ref": "#/$defs/resultArtifact" },
    "crop": { "$ref": "#/$defs/crop" },
    "coordinateSpace": { "const": "crop_pixel" },
    "projections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "projectionId", "semanticDeclarationRef", "truthLabelRef", "semanticRole",
          "ocrObservationRef", "textRegionCandidateRef", "associationRef", "recognizedText",
          "projectionBasis"
        ],
        "properties": {
          "projectionId": { "type": "string", "pattern": "^semantic-projection-[0-9]{3}$" },
          "semanticDeclarationRef": { "type": "string", "minLength": 1 },
          "truthLabelRef": { "type": "string", "pattern": "^truth-label-[0-9]{3}$" },
          "semanticRole": { "const": "measurement_reading" },
          "ocrObservationRef": { "type": "string", "pattern": "^ocr-observation-[0-9]{3}$" },
          "textRegionCandidateRef": { "type": "string", "pattern": "^text-region-[0-9]{3}$" },
          "associationRef": { "type": "string", "pattern": "^ocr-region-association-[0-9]{3}$" },
          "recognizedText": { "type": "string", "minLength": 1 },
          "projectionBasis": { "const": "declared_role_exact_truth_region_association" }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["declarationCount", "projectedCount", "withheldCount", "unavailableCount"],
      "properties": {
        "declarationCount": { "const": 1 },
        "projectedCount": { "const": 1 },
        "withheldCount": { "const": 0 },
        "unavailableCount": { "const": 0 }
      },
      "additionalProperties": false
    },
    "dispositions": { "$ref": "#/$defs/dispositions" },
    "projectionPolicySha256": { "$ref": "#/$defs/sha256" },
    "engineProvenance": { "$ref": "#/$defs/engine" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "declarationArtifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "declarationId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "declarationId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resultArtifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["artifactRef", "scale", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "scale": { "const": 2 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "decodedRgbPixelSha256": { "$ref": "#/$defs/sha256" },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dispositions": {
      "type": "object",
      "required": [
        "diagnosticScope", "semanticStatus", "acceptanceDisposition", "requiresHumanReview",
        "layoutDisposition", "figureUnderstandingDisposition", "trackDisposition",
        "deliveryTrustDisposition", "wpfDisposition", "liveAcceptanceDisposition",
        "controlsDisposition", "eligible", "optimizationCandidateRefs"
      ],
      "properties": {
        "diagnosticScope": { "const": "public_synthetic_semantic_projection" },
        "semanticStatus": { "const": "projected" },
        "acceptanceDisposition": { "const": "not_accepted" },
        "requiresHumanReview": { "const": true },
        "layoutDisposition": { "const": "not_inferred" },
        "figureUnderstandingDisposition": { "const": "not_generated" },
        "trackDisposition": { "const": "not_integrated" },
        "deliveryTrustDisposition": { "const": "not_projected" },
        "wpfDisposition": { "const": "not_integrated" },
        "liveAcceptanceDisposition": { "const": "not_accepted" },
        "controlsDisposition": { "const": "not_verified" },
        "eligible": { "const": false },
        "optimizationCandidateRefs": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": ["engineKind", "engineId", "engineVersion", "interpreter", "liveProvider", "cloudEgress"],
      "properties": {
        "engineKind": { "const": "deterministic_semantic_projection" },
        "engineId": { "const": "visual-semantic-projector" },
        "engineVersion": { "const": "1.0.0" },
        "interpreter": {
          "type": "object",
          "required": ["implementation", "version"],
          "properties": {
            "implementation": { "const": "CPython" },
            "version": { "const": "3.13.7" }
          },
          "additionalProperties": false
        },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
