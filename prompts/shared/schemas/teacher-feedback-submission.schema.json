{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/teacher-feedback-submission/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "TeacherFeedbackSubmission",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "submissionId",
    "sampleId",
    "subjectPack",
    "sourceRunRef",
    "sourceRunSha256",
    "fixtureKind",
    "dataClassification",
    "text",
    "reporter",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "kind": {
      "type": "string",
      "enum": ["teacher-feedback-submission"]
    },
    "submissionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sampleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "subjectPack": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceRunRef": { "type": "string", "minLength": 1 },
    "sourceRunSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixtureKind": {
      "type": "string",
      "enum": ["synthetic_fixture"]
    },
    "dataClassification": {
      "$ref": "data-classification.schema.json"
    },
    "text": { "type": "string", "minLength": 1 },
    "reporter": {
      "type": "string",
      "enum": ["synthetic_teacher_fixture"]
    },
    "createdAt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
