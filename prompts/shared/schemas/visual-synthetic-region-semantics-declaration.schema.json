{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-synthetic-region-semantics-declaration/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualSyntheticRegionSemanticsDeclaration",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "declarationId", "caseId", "subjectPack", "fixtureKind",
    "dataClassification", "regionDeclarations", "authorityProvenance", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-synthetic-region-semantics-declaration" },
    "declarationId": { "const": "junior-readable-measurement-region-semantics-declaration" },
    "caseId": { "const": "junior-readable-measurement" },
    "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": { "$ref": "#/$defs/dataClassification" },
    "regionDeclarations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/regionDeclaration" }
    },
    "authorityProvenance": {
      "type": "object",
      "required": [
        "authorityKind", "sourceBasis", "inferencePerformed", "liveProvider", "cloudEgress"
      ],
      "properties": {
        "authorityKind": { "const": "explicit_synthetic_region_semantics_declaration" },
        "sourceBasis": { "const": "fixture_author_declaration" },
        "inferencePerformed": { "const": false },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dataClassification": {
      "type": "object",
      "required": ["level", "containsPersonalData"],
      "properties": {
        "level": { "const": "public" },
        "containsPersonalData": { "const": false }
      },
      "additionalProperties": false
    },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "pixelSize": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "cropBinding": {
      "type": "object",
      "required": [
        "scale", "artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize",
        "interpolation"
      ],
      "properties": {
        "scale": { "enum": [1, 2] },
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "decodedRgbPixelSha256": { "$ref": "#/$defs/sha256" },
        "pixelSize": { "$ref": "#/$defs/pixelSize" },
        "interpolation": { "enum": ["pixel_preserving", "nearest"] }
      },
      "additionalProperties": false
    },
    "regionDeclaration": {
      "type": "object",
      "required": [
        "declarationRef", "proposalRef", "regionId", "regionType", "semanticRole",
        "componentKind", "proposalKind", "bbox", "cropBindings"
      ],
      "properties": {
        "declarationRef": { "pattern": "^region-semantic-declaration-[0-9]{3}$" },
        "proposalRef": { "pattern": "^content-block-[0-9]{3}$" },
        "regionId": { "type": "string", "minLength": 1 },
        "regionType": { "enum": ["text_area", "scale_area"] },
        "semanticRole": { "enum": ["measurement_reading", "measurement_scale_baseline"] },
        "componentKind": { "enum": ["recognized_value_component", "scale_baseline_component"] },
        "proposalKind": { "const": "content_block_candidate" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "cropBindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/cropBinding" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
