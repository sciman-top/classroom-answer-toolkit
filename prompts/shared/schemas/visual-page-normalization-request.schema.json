{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-page-normalization-request/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualPageNormalizationRequest",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind",
    "dataClassification", "capture", "targetPixelSize", "policy", "egressPolicy", "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-page-normalization-request" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": { "type": "string", "minLength": 1 },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": {
      "type": "object",
      "required": ["level", "containsPersonalData"],
      "properties": {
        "level": { "const": "public" },
        "containsPersonalData": { "const": false }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": ["artifactRef", "mediaType", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "mediaType": { "const": "image/png" },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "decodedRgbPixelSha256": { "$ref": "#/$defs/sha256" },
        "pixelSize": { "$ref": "#/$defs/pixelSize" }
      },
      "additionalProperties": false
    },
    "targetPixelSize": { "$ref": "#/$defs/pixelSize" },
    "policy": {
      "type": "object",
      "required": ["pageDetection", "minimumPageAreaRatio", "denoise", "outputInterpolation"],
      "properties": {
        "pageDetection": { "const": "largest_external_quadrilateral" },
        "minimumPageAreaRatio": { "const": 0.25 },
        "denoise": { "const": "median_3" },
        "outputInterpolation": { "const": "linear" }
      },
      "additionalProperties": false
    },
    "egressPolicy": {
      "type": "object",
      "required": ["allowCloud"],
      "properties": { "allowCloud": { "const": false } },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pixelSize": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
