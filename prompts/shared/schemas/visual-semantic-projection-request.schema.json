{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-semantic-projection-request/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualSemanticProjectionRequest",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "dataClassification",
    "semanticDeclaration", "ocrDiagnosticReport", "textRegionDiagnosticReport",
    "associationResult", "ocrObservationResult", "crop", "projectionPolicy", "egressPolicy",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-semantic-projection-request" },
    "requestId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subjectPack": { "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"] },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": { "$ref": "#/$defs/dataClassification" },
    "semanticDeclaration": { "$ref": "#/$defs/declarationArtifact" },
    "ocrDiagnosticReport": { "$ref": "#/$defs/artifact" },
    "textRegionDiagnosticReport": { "$ref": "#/$defs/artifact" },
    "associationResult": { "$ref": "#/$defs/resultArtifact" },
    "ocrObservationResult": { "$ref": "#/$defs/resultArtifact" },
    "crop": { "$ref": "#/$defs/crop" },
    "projectionPolicy": {
      "type": "object",
      "required": ["roleSource", "textSource", "evidenceTriangle", "cardinality", "ambiguityDisposition"],
      "properties": {
        "roleSource": { "const": "explicit_semantic_declaration" },
        "textSource": { "const": "bound_ocr_observation" },
        "evidenceTriangle": { "const": "truth_ocr_truth_region_association" },
        "cardinality": { "const": "exactly_one" },
        "ambiguityDisposition": { "const": "fail_closed" }
      },
      "additionalProperties": false
    },
    "egressPolicy": {
      "type": "object",
      "required": ["allowCloud"],
      "properties": { "allowCloud": { "const": false } },
      "additionalProperties": false
    },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "declarationArtifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "declarationId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "declarationId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resultArtifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dataClassification": {
      "type": "object",
      "required": ["level", "notes"],
      "properties": {
        "level": { "const": "public" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["artifactRef", "scale", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "scale": { "const": 2 },
        "rawByteSha256": { "$ref": "#/$defs/sha256" },
        "decodedRgbPixelSha256": { "$ref": "#/$defs/sha256" },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
