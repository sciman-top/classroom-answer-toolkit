{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/consistency-report/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "ConsistencyReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "consistencyReportId",
    "evidenceBundleRef",
    "trackResultRefs",
    "checks",
    "unsafeShortcutFail",
    "groundingSufficient",
    "recommendedDecisionReasons",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "consistency-report"
      ]
    },
    "consistencyReportId": { "type": "string" },
    "evidenceBundleRef": { "type": "string" },
    "trackResultRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validationScope": {
      "type": "string",
      "enum": ["public_synthetic_track_c_validator"]
    },
    "inputBindings": {
      "type": "object",
      "required": [
        "questionSha256", "evidenceBundleSha256", "semanticProjectionSha256",
        "solverRequestSha256", "trackBSha256", "validatorRequestSha256",
        "validatorPolicySha256"
      ],
      "properties": {
        "questionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidenceBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "semanticProjectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "solverRequestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "trackBSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validatorRequestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validatorPolicySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "checkId",
          "status",
          "message"
        ],
        "properties": {
          "checkId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warning",
              "fail",
              "blocking"
            ]
          },
          "message": { "type": "string" },
          "evidenceRef": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "unsafeShortcutFail": { "type": "boolean" },
    "groundingSufficient": { "type": "boolean" },
    "recommendedDecisionReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "unsafe_shortcut_fail",
          "grounding_insufficient",
          "acceptance_tier_unverified",
          "strict_schema_downgraded",
          "rule_validator_failed"
        ]
      }
    },
    "validatorProvenance": {
      "type": "object",
      "required": ["engineKind", "engineId", "engineVersion", "liveProvider", "cloudEgress"],
      "properties": {
        "engineKind": { "const": "deterministic_rule_validator" },
        "engineId": { "const": "synthetic-track-validator" },
        "engineVersion": { "const": "1.0.0" },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": true
    },
    "dispositions": {
      "type": "object",
      "required": [
        "trackDisposition", "requiresHumanReview", "deliveryTrustDisposition",
        "controlsDisposition", "eligible", "optimizationCandidateRefs"
      ],
      "properties": {
        "trackDisposition": { "const": "validated_not_orchestrated" },
        "requiresHumanReview": { "const": true },
        "deliveryTrustDisposition": { "const": "not_projected" },
        "controlsDisposition": { "const": "not_verified" },
        "eligible": { "const": false },
        "optimizationCandidateRefs": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
