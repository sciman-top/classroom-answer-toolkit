{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/answer-generation-result/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "AnswerGenerationResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "requestId",
    "subjectPack",
    "sourceRequestSha256",
    "answerMarkdown",
    "candidateArtifactRef",
    "rawAnswerSha256",
    "dataClassification",
    "provenance",
    "stopReason"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "kind": {
      "type": "string",
      "enum": ["answer-generation-result"]
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "subjectPack": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceRequestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "answerMarkdown": { "type": "string", "minLength": 1 },
    "candidateArtifactRef": { "type": "string", "minLength": 1 },
    "rawAnswerSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataClassification": {
      "$ref": "./data-classification.schema.json"
    },
    "provenance": {
      "type": "object",
      "required": [
        "providerKind",
        "providerId",
        "providerVersion",
        "liveProvider"
      ],
      "properties": {
        "providerKind": {
          "type": "string",
          "enum": ["synthetic_fixture", "model_provider"]
        },
        "providerId": { "type": "string", "minLength": 1 },
        "providerVersion": { "type": "string", "minLength": 1 },
        "liveProvider": { "type": "boolean" },
        "providerSurface": { "type": "string", "enum": ["responses", "chat_completions"] },
        "attemptCount": { "type": "integer", "minimum": 1 },
        "cloudEgress": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "providerKind": { "const": "synthetic_fixture" }
            },
            "required": ["providerKind"]
          },
          "then": {
            "properties": {
              "liveProvider": { "const": false }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "generationDisposition": {
      "type": "object",
      "required": ["reviewRequired", "trusted", "acceptanceDisposition", "workflowDisposition"],
      "properties": {
        "reviewRequired": { "const": true },
        "trusted": { "const": false },
        "acceptanceDisposition": { "const": "pending_review" },
        "workflowDisposition": { "const": "not_integrated" }
      },
      "additionalProperties": false
    },
    "stopReason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
