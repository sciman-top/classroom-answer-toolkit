{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-local-crop-result/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualLocalCropResult", "type": "object",
  "required": ["schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "sourceRequestSha256", "regionProposalResult", "normalizedArtifact", "coordinateSpace", "cropArtifacts", "summary", "engineProvenance", "dispositions", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "kind": { "const": "visual-local-crop-result" },
    "requestId": { "type": "string" }, "subjectPack": { "const": "junior-physics-answer" }, "fixtureKind": { "const": "synthetic_fixture" }, "sourceRequestSha256": { "$ref": "#/$defs/sha" },
    "regionProposalResult": { "type": "object", "required": ["artifactRef", "rawByteSha256", "requestId", "proposalRefs"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "requestId": { "type": "string" }, "proposalRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }, "additionalProperties": false },
    "normalizedArtifact": { "$ref": "#/$defs/artifact" }, "coordinateSpace": { "const": "normalized_page_pixel" },
    "cropArtifacts": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["proposalRef", "sourceBbox", "scale", "artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize", "interpolation"], "properties": { "proposalRef": { "type": "string", "pattern": "^content-block-[0-9]{3}$" }, "sourceBbox": { "$ref": "#/$defs/bbox" }, "scale": { "enum": [1, 2] }, "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "decodedRgbPixelSha256": { "$ref": "#/$defs/sha" }, "pixelSize": { "$ref": "#/$defs/size" }, "interpolation": { "enum": ["pixel_preserving", "nearest"] } }, "additionalProperties": false } },
    "summary": { "type": "object", "required": ["proposalCount", "cropArtifactCount"], "properties": { "proposalCount": { "type": "integer", "minimum": 1 }, "cropArtifactCount": { "type": "integer", "minimum": 2 } }, "additionalProperties": false },
    "engineProvenance": { "type": "object", "required": ["engineKind", "engineId", "engineVersion", "components", "liveProvider", "cloudEgress"], "properties": { "engineKind": { "const": "local_runtime" }, "engineId": { "const": "deterministic-visual-local-cropper" }, "engineVersion": { "const": "1.0.0" }, "components": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" } }, "additionalProperties": false } }, "liveProvider": { "const": false }, "cloudEgress": { "const": false } }, "additionalProperties": false },
    "dispositions": { "type": "object", "required": ["semanticDisposition", "visualRegionDisposition", "trackDisposition", "requiresHumanReview", "acceptanceDisposition", "controlsDisposition", "eligible", "optimizationCandidateRefs"], "properties": { "semanticDisposition": { "const": "not_inferred" }, "visualRegionDisposition": { "const": "not_generated" }, "trackDisposition": { "const": "not_integrated" }, "requiresHumanReview": { "const": true }, "acceptanceDisposition": { "const": "not_accepted" }, "controlsDisposition": { "const": "not_verified" }, "eligible": { "const": false }, "optimizationCandidateRefs": { "type": "array", "maxItems": 0 } }, "additionalProperties": false },
    "generatedAt": { "type": "string" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "bbox": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "artifact": { "type": "object", "required": ["artifactRef", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"], "properties": { "artifactRef": { "type": "string" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "decodedRgbPixelSha256": { "$ref": "#/$defs/sha" }, "pixelSize": { "$ref": "#/$defs/size" } }, "additionalProperties": false }
  }, "additionalProperties": false
}
