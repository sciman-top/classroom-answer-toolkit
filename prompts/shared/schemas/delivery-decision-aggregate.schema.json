{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/delivery-decision-aggregate/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "DeliveryDecisionAggregate",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "aggregateId",
    "subjectPack",
    "deliveryBinding",
    "coverageRef",
    "coverageSha256",
    "decisionRecords",
    "summary",
    "decision",
    "trusted",
    "visualReviewPassed",
    "reviewRequired",
    "reviewQueue",
    "decisionReasons",
    "statusProjection",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["delivery-decision-aggregate"]
    },
    "aggregateId": { "type": "string" },
    "subjectPack": { "type": "string" },
    "deliveryBinding": {
      "type": "object",
      "required": [
        "snapshotId",
        "snapshotSha256",
        "inputSha256",
        "manifestSha256"
      ],
      "properties": {
        "snapshotId": { "type": "string" },
        "snapshotSha256": { "type": "string" },
        "inputSha256": { "type": "string" },
        "manifestSha256": { "type": "string" }
      },
      "additionalProperties": true
    },
    "coverageRef": { "type": "string" },
    "coverageSha256": { "type": "string" },
    "decisionRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "questionRef",
          "decisionRecordRef",
          "decisionRecordSha256"
        ],
        "properties": {
          "questionRef": { "type": "string" },
          "decisionRecordRef": { "type": "string" },
          "decisionRecordSha256": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "expectedCount",
        "decidedCount",
        "acceptedCount",
        "unresolvedCount",
        "unresolvedQuestionRefs"
      ],
      "properties": {
        "expectedCount": { "type": "integer" },
        "decidedCount": { "type": "integer" },
        "acceptedCount": { "type": "integer" },
        "unresolvedCount": { "type": "integer" },
        "unresolvedQuestionRefs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "string",
      "enum": ["accept", "review_required", "reject"]
    },
    "trusted": { "type": "boolean" },
    "visualReviewPassed": {
      "anyOf": [
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "reviewRequired": { "type": "boolean" },
    "reviewQueue": {
      "type": "string",
      "enum": [
        "none",
        "needs_human_label",
        "high_risk_approval",
        "truth_needs_review"
      ]
    },
    "decisionReasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "statusProjection": {
      "type": "object",
      "required": ["visualReviewPassed", "trusted"],
      "properties": {
        "visualReviewPassed": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "trusted": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "generatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
