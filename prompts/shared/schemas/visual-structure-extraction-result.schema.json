{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-structure-extraction-result/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualStructureExtractionResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "requestId",
    "subjectPack",
    "fixtureKind",
    "sourceRequestSha256",
    "preprocessingResult",
    "crop",
    "coordinateSpace",
    "lineSegmentCandidates",
    "connectedRegionCandidates",
    "textRegionCandidates",
    "summary",
    "dispositions",
    "algorithmParameters",
    "engineProvenance",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-structure-extraction-result" },
    "requestId": { "type": "string", "minLength": 1 },
    "subjectPack": {
      "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"]
    },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceRequestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preprocessingResult": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256", "requestId"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requestId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["artifactRef", "scale", "rawByteSha256", "decodedRgbPixelSha256", "pixelSize"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "scale": { "const": 2 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedRgbPixelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pixelSize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coordinateSpace": { "const": "crop_pixel" },
    "lineSegmentCandidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidateId", "x1", "y1", "x2", "y2", "lengthSquared"],
        "properties": {
          "candidateId": { "type": "string", "pattern": "^line-[0-9]{3}$" },
          "x1": { "type": "integer", "minimum": 0 },
          "y1": { "type": "integer", "minimum": 0 },
          "x2": { "type": "integer", "minimum": 0 },
          "y2": { "type": "integer", "minimum": 0 },
          "lengthSquared": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "connectedRegionCandidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidateId", "bbox", "foregroundArea"],
        "properties": {
          "candidateId": { "type": "string", "pattern": "^region-[0-9]{3}$" },
          "bbox": { "$ref": "#/$defs/bbox" },
          "foregroundArea": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "textRegionCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidateId", "sourceRegionRef", "bbox", "foregroundArea", "heuristicOnly"],
        "properties": {
          "candidateId": { "type": "string", "pattern": "^text-region-[0-9]{3}$" },
          "sourceRegionRef": { "type": "string", "pattern": "^region-[0-9]{3}$" },
          "bbox": { "$ref": "#/$defs/bbox" },
          "foregroundArea": { "type": "integer", "minimum": 1 },
          "heuristicOnly": { "const": true }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["lineSegmentCount", "connectedRegionCount", "textRegionCandidateCount"],
      "properties": {
        "lineSegmentCount": { "type": "integer", "minimum": 1 },
        "connectedRegionCount": { "type": "integer", "minimum": 1 },
        "textRegionCandidateCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dispositions": {
      "type": "object",
      "required": ["ocrDisposition", "semanticDisposition", "trackDisposition"],
      "properties": {
        "ocrDisposition": { "const": "not_attempted" },
        "semanticDisposition": { "const": "not_inferred" },
        "trackDisposition": { "const": "not_integrated" }
      },
      "additionalProperties": false
    },
    "algorithmParameters": {
      "type": "object",
      "required": ["policySha256"],
      "properties": {
        "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "engineProvenance": {
      "type": "object",
      "required": ["engineKind", "engineId", "engineVersion", "components", "liveProvider", "cloudEgress"],
      "properties": {
        "engineKind": { "const": "local_runtime" },
        "engineId": { "type": "string", "minLength": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
