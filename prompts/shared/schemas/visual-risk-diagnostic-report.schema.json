{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-risk-diagnostic-report/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "VisualRiskDiagnosticReport",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "reportId",
    "fixtureSetId",
    "sourceInventoryRef",
    "sourceInventorySha256",
    "caseBindings",
    "subjectReports",
    "totals",
    "readinessBoundary",
    "optimizationCandidateRefs",
    "stopReason"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-risk-diagnostic-report" },
    "reportId": { "type": "string", "pattern": "^visual-risk-diagnostic-[a-f0-9]{16}$" },
    "fixtureSetId": { "type": "string", "minLength": 1 },
    "sourceInventoryRef": { "const": "visual-risk-case-inventory.json" },
    "sourceInventorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "caseBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "subjectPack",
          "evidenceBundleSha256",
          "trackResultSha256s",
          "expectedDecisionSha256",
          "replayedDecisionSha256",
          "replayDisposition",
          "falseReleased",
          "correctlyFlagged",
          "bindingCorrect",
          "ocrImageConflictDetected"
        ],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "subjectPack": { "type": "string", "minLength": 1 },
          "evidenceBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "trackResultSha256s": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "expectedDecisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "replayedDecisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "replayDisposition": { "enum": ["passed", "failed"] },
          "falseReleased": { "type": "boolean" },
          "correctlyFlagged": { "type": "boolean" },
          "bindingCorrect": { "type": "boolean" },
          "ocrImageConflictDetected": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "subjectReports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metricReport" }
    },
    "totals": { "$ref": "#/$defs/metricReport" },
    "readinessBoundary": {
      "type": "object",
      "required": ["toolchainControl", "restrictedEgressControl", "eligible"],
      "properties": {
        "toolchainControl": { "const": "not_verified" },
        "restrictedEgressControl": { "const": "not_verified" },
        "eligible": { "const": false }
      },
      "additionalProperties": false
    },
    "optimizationCandidateRefs": { "type": "array", "maxItems": 0 },
    "stopReason": { "const": "synthetic_visual_risk_diagnostic_only_no_optimizer" }
  },
  "$defs": {
    "metricReport": {
      "type": "object",
      "required": [
        "subjectPack",
        "totalCases",
        "expectedReviewCount",
        "falseReleaseCount",
        "falseReleaseRate",
        "correctlyFlaggedCount",
        "correctFlagRecall",
        "bindingCorrectCount",
        "bindingAccuracy",
        "replayPassedCount",
        "replayPassRate"
      ],
      "properties": {
        "subjectPack": { "type": "string", "minLength": 1 },
        "totalCases": { "type": "integer", "minimum": 1 },
        "expectedReviewCount": { "type": "integer", "minimum": 1 },
        "falseReleaseCount": { "type": "integer", "minimum": 0 },
        "falseReleaseRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "correctlyFlaggedCount": { "type": "integer", "minimum": 0 },
        "correctFlagRecall": { "type": "number", "minimum": 0, "maximum": 1 },
        "bindingCorrectCount": { "type": "integer", "minimum": 0 },
        "bindingAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "replayPassedCount": { "type": "integer", "minimum": 0 },
        "replayPassRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
