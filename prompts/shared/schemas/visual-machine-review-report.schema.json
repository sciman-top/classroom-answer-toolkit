{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-machine-review-report/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualMachineReviewReport",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "fixtureSetId", "fixtureKind", "sourceInventory",
    "caseReports", "subjectReports", "totals", "reviewPolicySha256",
    "dispositions", "engineProvenance", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-machine-review-report" },
    "fixtureSetId": { "const": "synthetic-visual-machine-review-v1" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceInventory": { "$ref": "#/$defs/artifact" },
    "caseReports": {
      "type": "array", "minItems": 3, "maxItems": 4,
      "items": { "$ref": "#/$defs/caseReport" }
    },
    "subjectReports": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/subjectReport" }
    },
    "totals": { "$ref": "#/$defs/metrics" },
    "reviewPolicySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dispositions": {
      "type": "object",
      "required": [
        "reviewStatus", "equivalencePolicy", "acceptanceScope",
        "humanIdentityDisposition", "deliveryTrustDisposition", "wpfDisposition",
        "liveAcceptanceDisposition", "controlsDisposition", "eligible",
        "optimizationCandidateRefs"
      ],
      "properties": {
        "reviewStatus": { "const": "completed" },
        "equivalencePolicy": { "const": "synthetic_fixture_equivalent" },
        "acceptanceScope": { "const": "synthetic_fixture_diagnostic" },
        "humanIdentityDisposition": { "const": "not_claimed" },
        "deliveryTrustDisposition": { "const": "not_projected" },
        "wpfDisposition": { "const": "not_integrated" },
        "liveAcceptanceDisposition": { "const": "not_accepted" },
        "controlsDisposition": { "const": "not_verified" },
        "eligible": { "const": false },
        "optimizationCandidateRefs": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "engineProvenance": {
      "type": "object",
      "required": [
        "engineKind", "engineId", "engineVersion", "interpreter",
        "liveProvider", "cloudEgress"
      ],
      "properties": {
        "engineKind": { "const": "deterministic_review_compiler" },
        "engineId": { "const": "visual-machine-review" },
        "engineVersion": { "const": "1.0.0" },
        "interpreter": {
          "type": "object",
          "required": ["implementation", "version"],
          "properties": {
            "implementation": { "const": "CPython" },
            "version": { "const": "3.13.7" }
          },
          "additionalProperties": false
        },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifactRef", "rawByteSha256"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "rawByteSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "caseReport": {
      "type": "object",
      "required": [
        "caseId", "subjectPack", "reviewReceipt", "crop", "decision",
        "limitationCount", "metrics"
      ],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "subjectPack": {
          "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"]
        },
        "reviewReceipt": { "$ref": "#/$defs/artifact" },
        "crop": { "$ref": "#/$defs/artifact" },
        "decision": {
          "enum": ["accept_for_diagnostic_use", "reject_for_diagnostic_use"]
        },
        "limitationCount": { "type": "integer", "minimum": 0 },
        "metrics": { "$ref": "#/$defs/metrics" }
      },
      "additionalProperties": false
    },
    "subjectReport": {
      "type": "object",
      "required": ["subjectPack", "caseCount", "metrics"],
      "properties": {
        "subjectPack": {
          "enum": ["math-answer", "junior-physics-answer", "senior-physics-answer"]
        },
        "caseCount": { "type": "integer", "minimum": 1 },
        "metrics": { "$ref": "#/$defs/metrics" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "reviewedCaseCount", "acceptedCaseCount", "rejectedCaseCount",
        "limitedCaseCount", "machineReviewedCount", "humanReviewedCount"
      ],
      "properties": {
        "reviewedCaseCount": { "type": "integer", "minimum": 0 },
        "acceptedCaseCount": { "type": "integer", "minimum": 0 },
        "rejectedCaseCount": { "type": "integer", "minimum": 0 },
        "limitedCaseCount": { "type": "integer", "minimum": 0 },
        "machineReviewedCount": { "type": "integer", "minimum": 0 },
        "humanReviewedCount": { "const": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
