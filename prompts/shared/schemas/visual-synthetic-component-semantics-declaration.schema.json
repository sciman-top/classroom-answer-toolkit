{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/visual-synthetic-component-semantics-declaration/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "VisualSyntheticComponentSemanticsDeclaration",
  "type": "object",
  "required": ["schemaVersion", "kind", "declarationId", "caseId", "subjectPack", "fixtureKind", "dataClassification", "componentDeclarations", "authorityProvenance", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "visual-synthetic-component-semantics-declaration" },
    "declarationId": { "const": "junior-instrument-scale-component-semantics-declaration" },
    "caseId": { "const": "junior-instrument-scale" },
    "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "dataClassification": { "$ref": "#/$defs/dataClassification" },
    "componentDeclarations": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/declaration" } },
    "authorityProvenance": {
      "type": "object",
      "required": ["authorityKind", "inferencePerformed", "liveProvider", "cloudEgress"],
      "properties": {
        "authorityKind": { "const": "explicit_synthetic_component_semantics_declaration" },
        "inferencePerformed": { "const": false },
        "liveProvider": { "const": false },
        "cloudEgress": { "const": false }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "dataClassification": {
      "type": "object", "required": ["level", "containsPersonalData"],
      "properties": { "level": { "const": "public" }, "containsPersonalData": { "const": false } },
      "additionalProperties": false
    },
    "declaration": {
      "type": "object",
      "required": ["componentRef", "componentType", "componentOrder", "candidateKind", "candidateRefs", "authorityBasis"],
      "properties": {
        "componentRef": { "pattern": "^scale-component-[0-9]{3}$" },
        "componentType": { "enum": ["pointer_indicator", "major_tick_mark"] },
        "componentOrder": { "type": "integer", "minimum": 0, "maximum": 5 },
        "candidateKind": { "const": "line_segment_candidate_pair" },
        "candidateRefs": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "pattern": "^line-[0-9]{3}$" } },
        "authorityBasis": { "const": "explicit_fixture_author_grouping" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
