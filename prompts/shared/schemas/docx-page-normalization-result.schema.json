{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/docx-page-normalization-result/v1.json",
  "compatibility": { "forward": "additive", "backward": "additive" },
  "title": "DocxPageNormalizationResult",
  "type": "object",
  "required": ["schemaVersion", "kind", "requestId", "subjectPack", "fixtureKind", "sourceRequestSha256", "sourceDocument", "adapterProfile", "packageInspection", "pages", "summary", "engineProvenance", "dispositions", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "docx-page-normalization-result" },
    "requestId": { "const": "junior-image-backed-page-normalization" },
    "subjectPack": { "const": "junior-physics-answer" },
    "fixtureKind": { "const": "synthetic_fixture" },
    "sourceRequestSha256": { "$ref": "#/$defs/sha" },
    "sourceDocument": { "$ref": "#/$defs/source" },
    "adapterProfile": { "const": "image_backed_single_page_only" },
    "packageInspection": { "$ref": "#/$defs/packageInspection" },
    "pages": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/page" } },
    "summary": { "type": "object", "required": ["pageCount", "embeddedImageCount"], "properties": { "pageCount": { "const": 1 }, "embeddedImageCount": { "const": 1 } }, "additionalProperties": false },
    "engineProvenance": { "$ref": "#/$defs/provenance" },
    "dispositions": { "$ref": "#/$defs/dispositions" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": { "type": "object", "required": ["artifactRef", "rawByteSha256", "sourceKind"], "properties": { "artifactRef": { "const": "junior-image-backed-page.docx" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "sourceKind": { "const": "docx" } }, "additionalProperties": false },
    "size": { "type": "object", "required": ["width", "height"], "properties": { "width": { "const": 560 }, "height": { "const": 360 } }, "additionalProperties": false },
    "packageInspection": { "type": "object", "required": ["entryCount", "uncompressedBytes", "documentPart", "relationshipId", "imagePart", "imageExtentEmu"], "properties": { "entryCount": { "const": 18 }, "uncompressedBytes": { "const": 957012 }, "documentPart": { "const": "word/document.xml" }, "relationshipId": { "const": "rId9" }, "imagePart": { "const": "word/media/image1.png" }, "imageExtentEmu": { "type": "object", "required": ["cx", "cy"], "properties": { "cx": { "const": 5943600 }, "cy": { "const": 3820886 } }, "additionalProperties": false } }, "additionalProperties": false },
    "preprocessing": { "type": "object", "required": ["orientationDegrees", "deskewApplied", "denoiseApplied", "trimApplied", "perspectiveCorrectionApplied"], "properties": { "orientationDegrees": { "const": 0 }, "deskewApplied": { "const": false }, "denoiseApplied": { "const": false }, "trimApplied": { "const": false }, "perspectiveCorrectionApplied": { "const": false } }, "additionalProperties": false },
    "normalizedPage": { "type": "object", "required": ["schemaVersion", "kind", "pageId", "sourceDocument", "sourceKind", "pageNumber", "imagePath", "pixelSize", "dpi", "renderScales", "preprocessing", "regionRefs", "ocrRefs", "layoutRefs", "qualityFlags", "generatedAt"], "properties": { "schemaVersion": { "const": "1.0" }, "kind": { "const": "normalized-page" }, "pageId": { "const": "junior-image-backed-page-1" }, "sourceDocument": { "const": "junior-image-backed-page.docx" }, "sourceKind": { "const": "docx" }, "pageNumber": { "const": 1 }, "imagePath": { "const": "page-001.png" }, "pixelSize": { "$ref": "#/$defs/size" }, "dpi": { "const": 96 }, "renderScales": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": 1 } }, "preprocessing": { "$ref": "#/$defs/preprocessing" }, "regionRefs": { "type": "array", "maxItems": 0 }, "ocrRefs": { "type": "array", "maxItems": 0 }, "layoutRefs": { "type": "array", "maxItems": 0 }, "qualityFlags": { "type": "array", "maxItems": 0 }, "generatedAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
    "page": { "type": "object", "required": ["pageRef", "sourceImagePart", "rawByteSha256", "decodedRgbPixelSha256", "normalizedPage"], "properties": { "pageRef": { "const": "docx-page-001" }, "sourceImagePart": { "const": "word/media/image1.png" }, "rawByteSha256": { "$ref": "#/$defs/sha" }, "decodedRgbPixelSha256": { "$ref": "#/$defs/sha" }, "normalizedPage": { "$ref": "#/$defs/normalizedPage" } }, "additionalProperties": false },
    "provenance": { "type": "object", "required": ["engineKind", "engineId", "engineVersion", "liveProvider", "cloudEgress"], "properties": { "engineKind": { "const": "local_runtime" }, "engineId": { "const": "python-stdlib-opc-ooxml-image-page-adapter" }, "engineVersion": { "const": "1.0.0" }, "liveProvider": { "const": false }, "cloudEgress": { "const": false } }, "additionalProperties": false },
    "dispositions": { "type": "object", "required": ["adapterDisposition", "layoutDisposition", "bodyTextDisposition", "tableDisposition", "ommlDisposition", "paginationDisposition", "regionDisposition", "ocrDisposition", "trackDisposition", "answerDisposition", "requiresHumanReview", "acceptanceDisposition", "controlsDisposition", "eligible", "optimizationCandidateRefs"], "properties": { "adapterDisposition": { "const": "image_backed_single_page_only" }, "layoutDisposition": { "const": "not_reconstructed" }, "bodyTextDisposition": { "const": "not_extracted" }, "tableDisposition": { "const": "not_supported" }, "ommlDisposition": { "const": "not_supported" }, "paginationDisposition": { "const": "single_page_declared_shape_only" }, "regionDisposition": { "const": "not_generated" }, "ocrDisposition": { "const": "not_attempted" }, "trackDisposition": { "const": "not_integrated" }, "answerDisposition": { "const": "not_generated" }, "requiresHumanReview": { "const": true }, "acceptanceDisposition": { "const": "not_accepted" }, "controlsDisposition": { "const": "not_verified" }, "eligible": { "const": false }, "optimizationCandidateRefs": { "type": "array", "maxItems": 0 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
