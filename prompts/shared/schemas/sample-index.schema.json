{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-toolkit.dev/schemas/sample-index/v1.json",
  "compatibility": {
    "forward": "additive",
    "backward": "additive"
  },
  "title": "SampleIndex",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "samples"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "sample-index"
      ]
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sampleId",
          "subjectPack",
          "packageRef",
          "packageSha256",
          "dataClassification",
          "expectedQuestionRefs",
          "problemSource",
          "referenceTruth",
          "teacherAnnotation",
          "candidateRefs",
          "candidateBindings"
        ],
        "properties": {
          "sampleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "subjectPack": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "packageRef": { "type": "string", "minLength": 1 },
          "packageSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dataClassification": {
            "$ref": "./data-classification.schema.json"
          },
          "expectedQuestionRefs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "problemSource": {
            "type": "array",
            "items": { "type": "string" }
          },
          "referenceTruth": {
            "type": "array",
            "items": { "type": "string" }
          },
          "teacherAnnotation": {
            "type": "array",
            "items": { "type": "string" }
          },
          "candidateRefs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "candidateBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "sha256"
              ],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
