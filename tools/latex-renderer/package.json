{
  "name": "classroom-toolkit-latex-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cleanup": "node cleanup-answer-artifacts.mjs",
    "deliver": "node deliver-answer.mjs",
    "eval:answer": "node eval-answer-fixtures.mjs",
    "eval:math": "node eval-answer-fixtures.mjs --subject-pack math-answer",
    "test:delivery-contract": "node --test validate-delivery-manifest.test.mjs delivery-portability.test.mjs",
    "test:eval-runtime": "node --test eval-answer-fixtures.test.mjs",
    "render": "node render-md-latex.mjs",
    "test:output-path": "node --test ../shared.test.mjs lib/pdf-output-path.test.mjs lib/focus-region-spec.test.mjs lib/analog-meter-reading.test.mjs lib/linear-scale-reading.test.mjs lib/optical-ray-geometry.test.mjs lib/review-page-selection.test.mjs lib/review-html.test.mjs",
    "test:render": "node --test render-md-latex.test.mjs validate-answer-markdown.test.mjs export-answer-docx.test.mjs",
    "test:visual": "node --test visual-regression.test.mjs",
    "review-source-pdf": "node review-source-pdf.mjs",
    "validate:answer": "node validate-answer-markdown.mjs",
    "visual:compare": "node visual-regression.mjs",
    "validate:delivery-manifest": "node validate-delivery-manifest.mjs",
    "write:delivery-manifest": "node write-delivery-manifest.mjs",
    "export:docx": "node export-answer-docx.mjs",
    "build:docx-reference": "node build-docx-reference.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "fflate": "^0.8.3",
    "katex": "^0.16.25",
    "markdown-it": "^14.3.0",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.57.0",
    "tesseract.js": "^7.0.0"
  }
}
