# Classroom Answer Toolkit AI gateway configuration template.
# Copy to .env for local use. Keep real keys out of version control.

# The answer gateway is the local Cockpit API Service. Keep live calls disabled
# in the template until the local service and bearer token have been verified.
CLASSROOM_TOOLKIT_CLOUD_EGRESS_ENABLED=false
CLASSROOM_TOOLKIT_AI_EXECUTION_SLOT_COUNT=5
# Cross-process lease and health state use the OS temporary directory by default.
# Set this only to isolate intentionally separate local checkouts.
CLASSROOM_TOOLKIT_AI_RUNTIME_DIRECTORY=
CLASSROOM_TOOLKIT_AI_PRESET_COOLDOWN_MS=120000
# A separately started recovery reconciler probes Sol only while a fallback
# preset is active. It uses no business execution slot and needs two exact OK
# responses before the next business request can return to Sol-first routing.
CLASSROOM_TOOLKIT_AI_RECOVERY_PROBE_ENABLED=false
CLASSROOM_TOOLKIT_AI_RECOVERY_PROBE_INTERVAL_MS=300000
CLASSROOM_TOOLKIT_AI_RECOVERY_PROBE_FAILURE_INTERVAL_MS=900000
CLASSROOM_TOOLKIT_AI_RECOVERY_PROBE_SUCCESS_THRESHOLD=2
CLASSROOM_TOOLKIT_AI_RECOVERY_PROBE_JITTER_MS=30000
CLASSROOM_TOOLKIT_AI_RECOVERY_PROBE_TIMEOUT_MS=10000

# Primary local Cockpit OpenAI-compatible gateway for text planning and vision understanding.
CLASSROOM_TOOLKIT_AI_PRIMARY_KIND=openai_compatible
CLASSROOM_TOOLKIT_AI_PRIMARY_BASE_URL=http://localhost:45335/v1
CLASSROOM_TOOLKIT_AI_PRIMARY_API_KEY=
CLASSROOM_TOOLKIT_AI_PRIMARY_TEXT_MODEL=gpt-5.6-sol
CLASSROOM_TOOLKIT_AI_PRIMARY_VISION_MODEL=gpt-5.6-sol
CLASSROOM_TOOLKIT_AI_PRIMARY_REASONING_EFFORT=high
CLASSROOM_TOOLKIT_AI_PRIMARY_TEXT_SURFACE=responses
CLASSROOM_TOOLKIT_AI_PRIMARY_VISION_SURFACE=responses

# One local connection serves all three presets. Each selected preset owns all
# five logical slots; a slot can repeat one of that preset's three profiles.
# Cross-preset profiles are rejected by configuration validation.
CLASSROOM_TOOLKIT_AI_PRESET_SOL_SLOT_1=sol-high
CLASSROOM_TOOLKIT_AI_PRESET_SOL_SLOT_2=sol-high
CLASSROOM_TOOLKIT_AI_PRESET_SOL_SLOT_3=sol-medium
CLASSROOM_TOOLKIT_AI_PRESET_SOL_SLOT_4=sol-medium
CLASSROOM_TOOLKIT_AI_PRESET_SOL_SLOT_5=sol-low
CLASSROOM_TOOLKIT_AI_PRESET_TERRA_SLOT_1=terra-xhigh
CLASSROOM_TOOLKIT_AI_PRESET_TERRA_SLOT_2=terra-xhigh
CLASSROOM_TOOLKIT_AI_PRESET_TERRA_SLOT_3=terra-high
CLASSROOM_TOOLKIT_AI_PRESET_TERRA_SLOT_4=terra-high
CLASSROOM_TOOLKIT_AI_PRESET_TERRA_SLOT_5=terra-medium
CLASSROOM_TOOLKIT_AI_PRESET_LUNA_SLOT_1=luna-xhigh
CLASSROOM_TOOLKIT_AI_PRESET_LUNA_SLOT_2=luna-xhigh
CLASSROOM_TOOLKIT_AI_PRESET_LUNA_SLOT_3=luna-high
CLASSROOM_TOOLKIT_AI_PRESET_LUNA_SLOT_4=luna-high
CLASSROOM_TOOLKIT_AI_PRESET_LUNA_SLOT_5=luna-medium
