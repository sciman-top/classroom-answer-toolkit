# Classroom Answer Toolkit AI gateway configuration template.
# Copy to .env for local use. Keep real keys out of version control.

# Cloud egress is disabled unless this is explicitly set to true.
CLASSROOM_TOOLKIT_CLOUD_EGRESS_ENABLED=false

# Primary OpenAI-compatible gateway for text planning and vision understanding.
CLASSROOM_TOOLKIT_AI_PRIMARY_KIND=openai_compatible
CLASSROOM_TOOLKIT_AI_PRIMARY_BASE_URL=https://primary.example.com/v1
CLASSROOM_TOOLKIT_AI_PRIMARY_API_KEY=
CLASSROOM_TOOLKIT_AI_PRIMARY_TEXT_MODEL=gpt-5.6-sol
CLASSROOM_TOOLKIT_AI_PRIMARY_VISION_MODEL=gpt-5.6-sol
CLASSROOM_TOOLKIT_AI_PRIMARY_REASONING_EFFORT=xhigh
CLASSROOM_TOOLKIT_AI_PRIMARY_TEXT_SURFACE=responses
CLASSROOM_TOOLKIT_AI_PRIMARY_VISION_SURFACE=responses

# Fallback OpenAI-compatible gateway.
# Connection inheritance contract:
# - Set INHERIT_PRIMARY=true to inherit the primary endpoint/key/surfaces
#   entirely; combining it with local connection fields is a configuration error.
# - Set BASE_URL and API_KEY locally for an explicitly separate gateway
#   (BASE_URL without a local API_KEY is rejected: it would reuse the primary
#   key across gateways).
# - Omitting connection fields entirely still inherits implicitly for now
#   (connectionSource=primary) but produces a migration warning; migrate to the
#   explicit INHERIT_PRIMARY=true form.
#CLASSROOM_TOOLKIT_AI_FALLBACK_1_INHERIT_PRIMARY=true
CLASSROOM_TOOLKIT_AI_FALLBACK_1_TEXT_MODEL=gpt-5.6-sol
CLASSROOM_TOOLKIT_AI_FALLBACK_1_VISION_MODEL=gpt-5.6-sol
CLASSROOM_TOOLKIT_AI_FALLBACK_1_REASONING_EFFORT=medium

CLASSROOM_TOOLKIT_AI_FALLBACK_2_TEXT_MODEL=gpt-5.6-terra
CLASSROOM_TOOLKIT_AI_FALLBACK_2_VISION_MODEL=gpt-5.6-terra
CLASSROOM_TOOLKIT_AI_FALLBACK_2_REASONING_EFFORT=xhigh

CLASSROOM_TOOLKIT_AI_FALLBACK_3_TEXT_MODEL=gpt-5.6-terra
CLASSROOM_TOOLKIT_AI_FALLBACK_3_VISION_MODEL=gpt-5.6-terra
CLASSROOM_TOOLKIT_AI_FALLBACK_3_REASONING_EFFORT=high
